/* ===== HUD ROOT ===== */
.hud {
    position: absolute;
    width: 100%; height: 100%;
    padding: 24px;
    flex-direction: column;
    justify-content: space-between;
}

.root-container-visibility {
    visibility: visible;
    display: none;
}

.hud-visibility-visible {
    visibility: visible;
}

/* Positions by ID */
/* Push to edges as requested - 0px margin/offset */
#hud-panel #health-container { position: absolute; left: 0; bottom: 0; margin: 0; }
#grapple-indicator-bottom { position: absolute; left: 50%; bottom: 96px; translate: -50% 0; }
#multiplier-container { position: absolute; left: 50%; bottom: 0; translate: -50% 0; margin: 0; }
#hud-panel #ammo-container { position: absolute; right: 0; bottom: 0; margin: 0; }

/* Stat containers */
.multiplier-container {
    flex-direction: row; 
    align-items: center;
    min-height: 56px; 
    padding: 8px 16px;
    background-color: rgba(12, 12, 18, 0.4);
    border-top-width: 2px;
    border-top-color: rgba(60, 150, 200, 0.6);
}

.health-container, .ammo-container {
    flex-direction: row; 
    align-items: center;
    min-height: 84px; 
    padding: 8px 16px;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 0;
    border-width: 0;
}



/* Bars */
.health-bar {
    width: 260px; 
    height: 32px;
    min-height: 32px;
    margin: 0;
    margin-right: 20px;
    padding: 0;
    background-color: transparent;
    border-width: 0;
}

.health-bar .unity-progress-bar__container {
    background-color: transparent;
    border-width: 0;
    margin: 0;
    padding: 0;
    max-height: none;
    min-height: 32px;
    height: 32px;
}

.health-bar .unity-progress-bar__background {
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.8);
    margin: 0;
    padding: 0;
    max-height: none;
    min-height: 32px;
    height: 32px;
}

.multiplier-bar {
    width: 180px; height: 22px; margin-right: 12px;
    border-radius: 4px; background-color: rgba(5, 5, 8, 0.8);
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.2);
}
.health-bar .unity-progress-bar__progress { 
    background-color: rgb(200, 60, 60);
    background-image: none;
    border-width: 0;
    border-radius: 0;
    margin: 0;
    padding: 0;
    height: 32px;
    min-height: 32px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.2);
}
.multiplier-bar .unity-progress-bar__progress { 
    background-color: rgb(60, 150, 200);
    background-image: none;
    border-radius: 4px;
}

.multiplier-bar .unity-progress-bar__background {
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 1px;
    border-color: rgba(60, 150, 200, 0.3);
}

.multiplier-bar .unity-progress-bar__container {
    max-height: none;
    min-height: 22px;
    height: 22px;
}

/* Values */
.health-value {
    color: white; 
    font-size: 44px; 
    -unity-font-style: bold; 
    min-width: 80px; 
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
    text-shadow: 2px 2px 3px rgba(0, 0, 0, 1);
}

.multiplier-value {
    color: white; font-size: 22px; -unity-font-style: bold; min-width: 60px; -unity-text-align: middle-right;
}
.ammo-text {
    color: white; 
    font-size: 44px; 
    -unity-font-style: bold; 
    min-width: 60px; 
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 3px rgba(0, 0, 0, 1);
}

.ammo-total {
    color: rgba(255, 255, 255, 0.4);
    font-size: 30px;
    margin-top: 6px; 
}

.ammo-separator {
    width: 3px;
    height: 48px;
    background-color: rgb(200, 60, 60);
    margin: 0 18px;
}

/* Crosshair */
.crosshair { 
    position: absolute; 
    width: 100%; 
    height: 100%; 
    align-items: center; 
    justify-content: center;
    top: 0; left: 0; bottom: 0; right: 0;
}
.crosshair-line { position: absolute; background-color: rgb(200,60,60); }
.crosshair-line.horizontal { width: 18px; height: 2px; }
.crosshair-line.vertical   { width: 2px; height: 18px; }
.hopball-interact-prompt {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% 28px;
    display: none;
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 3px rgba(0, 0, 0, 1);
}

/* Bottom grapple indicator (horizontal bar) */
.grapple-indicator-bottom {
    width: 160px;
    height: 6px;
    border-radius: 4px;
    border-width: 0;
    background-color: rgba(20, 10, 10, 0.6);
    overflow: hidden;
    flex-direction: row;
    justify-content: flex-start;
}

.grapple-indicator-fill {
    width: 0;
    height: 100%;
    background-color: rgba(200, 60, 60, 0.9);
    transition-duration: 0.1s;
    transition-property: background-color, opacity;
    transition-timing-function: linear;
}

/* Center grapple indicator (horseshoe) */
.grapple-indicator { 
    position: absolute;
    width: 50px;
    height: 50px;
}

/* Pause / Options */
.menu-container { width: 420px; padding: 28px; }
.options-container { width: 100%; max-height: 100%; padding: 0; }

.pause-challenges-container {
    position: absolute;
    left: 24px;
    top: 24px;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
}

.pause-challenges-slot {
    flex-direction: column;
}

.pause-challenges-slot-daily {
    margin-right: 0;
    margin-bottom: 14px;
}

.pause-challenges-slot-weekly {
    margin-left: 0;
}

.pause-challenges-spacer {
    display: none;
}

.pause-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 18px;
}

.pause-header-align-flex-start {
    align-items: flex-start;
}

.pause-join-code-display {
    flex-direction: row;
    align-items: center;
}

.pause-join-code-display-margin-top-7px {
    margin-top: 7px;
}

.pause-join-code-label-margin-right-5px {
    margin-right: 5px;
}

.pause-join-code-label-inline {
    min-width: auto;
    width: auto;
    min-height: auto;
    margin-right: 0;
    margin-left: 0;
    padding-right: 0;
    font-size: 14px;
}

.copy-button {
    width: 36px;
    min-width: 36px;
    height: 36px;
    min-height: 36px;
    max-height: 36px;
    padding-left: 0;
    padding-right: 0;
    align-items: center;
    justify-content: center;
}

.copy-icon {
    width: 20px;
    height: 20px;
    margin: auto;
    --unity-image: url('/Assets/UI Toolkit/Images/copy.png');
}

.pause-loadout-container {
    position: absolute;
    top: 24px;
    right: 24px;
    width: 230px;
    padding: 14px;
    flex-direction: column;
    align-items: flex-start;
    overflow: visible;
}

.pause-loadout-title {
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 10px;
}

.pause-weapon-slot-container {
    width: 100%;
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 12px;
    overflow: visible;
}

.pause-weapon-slot-row {
    width: 100%;
    flex-direction: row;
    align-items: center;
    position: relative;
    overflow: visible;
}

.pause-weapon-slot {
    width: 200px;
    height: 96px;
    background-color: rgba(15, 15, 20, 0.95);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.2);
    align-items: center;
    justify-content: center;
    position: relative;
    transition-duration: 0.2s;
}

.pause-weapon-slot:hover {
    border-color: rgba(255, 100, 100, 0.4);
    background-color: rgba(20, 20, 25, 0.95);
}

.pause-weapon-image {
    width: 146px;
    height: 68px;
    -unity-background-scale-mode: scale-to-fit;
}

.pause-weapon-name {
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 6px;
    font-size: 11px;
    color: rgba(235, 235, 235, 0.92);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.pause-weapon-slot-label {
    margin-top: 5px;
    margin-left: 2px;
    font-size: 11px;
    color: rgba(185, 185, 185, 1);
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.pause-weapon-dropdown {
    position: absolute;
    right: 208px;
    top: 0;
    width: auto;
    max-width: 560px;
    max-height: 96px;
    background-color: rgba(12, 12, 18, 0.98);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.3);
    padding: 8px;
    margin-right: 14px;
    overflow: visible;
}

.pause-weapon-dropdown-scroll {
    max-height: 80px;
    overflow: visible;
}

.pause-weapon-dropdown-scroll .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: nowrap;
}

.pause-loadout-option {
    width: 104px;
    height: 74px;
    min-width: 104px;
    background-color: rgba(20, 20, 25, 0.9);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.2);
    margin-right: 6px;
    padding: 4px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition-duration: 0.2s;
}

.pause-loadout-option:hover {
    background-color: rgba(30, 30, 35, 0.9);
    border-color: rgba(255, 100, 100, 0.45);
}

.pause-loadout-option-image {
    width: 90px;
    height: 50px;
    -unity-background-scale-mode: scale-to-fit;
}

.pause-loadout-option-name {
    margin-top: 3px;
    font-size: 9px;
    color: rgba(220, 220, 220, 0.95);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.pause-weapon-dropdown-scroll .unity-scroll-view__vertical-scrollbars,
.pause-weapon-dropdown-scroll .unity-scroll-view__horizontal-scrollbars,
.pause-weapon-dropdown-scroll .unity-scroller__low-button,
.pause-weapon-dropdown-scroll .unity-scroller__high-button,
.pause-weapon-dropdown-scroll .unity-scroller__slider,
.pause-weapon-dropdown-scroll .unity-scroller__track {
    display: none;
    width: 0;
    height: 0;
    min-width: 0;
    min-height: 0;
    max-width: 0;
    max-height: 0;
}

/* ===== SCOREBOARD ===== */

.scoreboard-container {
    width: 1100px;
    max-height: 85%;
    padding: 15px 30px; /* Reduced vertical padding */
    flex-direction: column;
}

.scoreboard-title-row {
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}

.scoreboard-mode-title {
    margin-bottom: 0;
}

.scoreboard-map-title {
    margin-bottom: 0;
    -unity-text-align: middle-right;
}

.scoreboard-header {
    flex-direction: row;
    align-items: center;
    padding: 6px 16px; /* Reduced vertical padding */
    background-color: rgba(200, 60, 60, 0.15);
    border-radius: 4px;
    margin-bottom: 6px;
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.3);
}

.scoreboard-header-height-38px {
    height: 38px;
}

.header-cell {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

.ping-cell {
    width: 40px;
    min-width: 40px;
    flex-shrink: 0;
}

.avatar-cell {
    width: 32px; /* Reduced from 40 */
    height: 32px;
    min-width: 32px;
    margin-left: 8px;
    margin-right: 8px;
    flex-shrink: 0;
}

.name-cell {
    flex-grow: 1;
    min-width: 150px; /* Reduced min-width */
    -unity-text-align: middle-left;
    margin-left: 8px;
}

.stat-cell {
    width: 60px;
    min-width: 60px;
    flex-shrink: 0;
}

.scoreboard-scroll {
    flex-grow: 1;
    max-height: 560px; /* Increased slightly */
}

.player-rows {
    flex-direction: column;
}

.player-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 12px; /* Reduced further */
    background-color: rgba(15, 15, 20, 0.7);
    border-radius: 4px;
    margin-bottom: 2px;
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.15);
    transition-duration: 0.2s;
}

.player-row-alt {
    background-color: rgba(10, 10, 15, 0.5);
}

.player-row-empty {
    opacity: 0.3;
}

.player-row:hover {
    background-color: rgba(25, 25, 30, 0.85);
    border-color: rgba(255, 100, 100, 0.3);
}

.player-row-local {
    background-color: rgba(200, 60, 60, 0.12);
    border-color: rgba(255, 100, 100, 0.3);
}

.player-row-local:hover {
    background-color: rgba(200, 60, 60, 0.2);
    border-color: rgba(255, 100, 100, 0.5);
}

.player-row-local-your-team {
    background-color: rgba(50, 100, 255, 0.12);
    border-color: rgba(100, 150, 255, 0.3);
}

.player-row-local-your-team:hover {
    background-color: rgba(50, 100, 255, 0.2);
    border-color: rgba(100, 150, 255, 0.5);
}

.scoreboard-hover-disabled .player-row:hover {
    background-color: rgba(15, 15, 20, 0.7);
    border-color: rgba(200, 60, 60, 0.15);
}

.scoreboard-hover-disabled .player-row-local:hover {
    background-color: rgba(200, 60, 60, 0.12);
    border-color: rgba(255, 100, 100, 0.3);
}

.scoreboard-hover-disabled .player-row-local-your-team:hover {
    background-color: rgba(50, 100, 255, 0.12);
    border-color: rgba(100, 150, 255, 0.3);
}

.player-ping {
    width: 40px;
    min-width: 40px;
    font-size: 13px;
    -unity-text-align: middle-center;
    color: rgb(100, 200, 100);
    flex-shrink: 0;
}

.player-ping-high {
    color: rgb(255, 200, 100);
}

.player-ping-critical {
    color: rgb(255, 100, 100);
}

.player-avatar {
    width: 32px; /* Reduced from 40 */
    height: 32px;
    min-width: 32px;
    margin-left: 8px;
    margin-right: 8px;
    border-radius: 4px;
    background-color: rgba(20, 20, 25, 0.6);
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.2);
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.player-name {
    flex-grow: 1;
    min-width: 120px;
    font-size: 14px;
    color: rgb(240, 240, 240);
    -unity-text-align: middle-left;
    margin-left: 8px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.player-stat {
    width: 60px;
    min-width: 60px;
    font-size: 14px;
    -unity-text-align: middle-center;
    color: rgb(200, 200, 200);
    flex-shrink: 0;
}

.player-stat-highlight {
    color: rgb(255, 200, 100);
    -unity-font-style: bold;
}

/* ===== TDM SCOREBOARD ===== */

.tdm-scoreboard-container {
    width: 1100px;
    max-height: 85%;
    padding: 15px 24px;
    flex-direction: column;
}

.tdm-scoreboard-title {
    margin-bottom: 12px;
}

.tdm-team-section {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
}

.tdm-team-section-enemy {
    margin-bottom: 6px;
}

.tdm-team-section-your {
}

.tdm-team-label {
    font-size: 16px; /* Slightly smaller */
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 8px;
    letter-spacing: 2px;
}

.tdm-team-header {
    flex-direction: row;
    align-items: center;
    padding: 4px 12px; /* Reduced */
    background-color: rgba(200, 60, 60, 0.15);
    border-radius: 4px;
    margin-bottom: 2px; /* Reduced */
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.3);
    height: 28px; /* Reduced from 32 */
}

.tdm-team-header-your {
    background-color: rgba(50, 100, 255, 0.15);
    border-color: rgba(100, 150, 255, 0.3);
}

.tdm-team-scroll {
    flex-grow: 1;
    max-height: 250px;
    min-height: 80px;
}

.tdm-score-display {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin-bottom: 6px;
}

.tdm-score-enemy {
    margin-right: 15px;
}

.tdm-vs-label {
    margin-left: 15px;
    margin-right: 15px;
}

.tdm-score-your {
    margin-left: 15px;
}

.tdm-score-container {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    min-width: 50px;
    min-height: 50px;
    padding: 0;
    border-radius: 4px;
    background-color: rgba(15, 15, 20, 0.9);
    border-width: 1px;
}

.tdm-score-enemy {
    border-color: rgba(255, 100, 100, 0.4);
    background-color: rgba(255, 50, 50, 0.1);
}

.tdm-score-your {
    border-color: rgba(100, 150, 255, 0.4);
    background-color: rgba(50, 100, 255, 0.1);
}

.tdm-score-value {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
}

.tdm-vs-label {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 1px;
}

.tdm-score-display-styled {
    min-width: auto;
    max-height: none;
}

.tdm-score-container-styled {
    margin-left: 0;
    margin-right: 15px;
    width: 50px;
    height: 50px;
    min-width: 50px;
    min-height: 50px;
    max-width: 50px;
    max-height: 50px;
}

.tdm-score-container-enemy-styled {
    margin-left: 15px;
    margin-right: 0;
    width: 50px;
    height: 50px;
    min-width: 50px;
    min-height: 50px;
    max-width: 50px;
    max-height: 50px;
}

.tdm-score-value-styled {
    font-size: 24px;
    padding: 0;
    margin: 0;
}

.tdm-vs-label-styled {
    padding-left: 2px;
    font-size: 14px;
}

/* ===== KILL FEED ===== */

.kill-feed-container {
    position: absolute;
    top: 30px;
    right: 30px;
    width: 350px;
    flex-direction: column;
    align-items: flex-end;
    justify-content: flex-start;
}

.kill-entry {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding: 8px 12px;
    margin-bottom: 6px;
    border-radius: 4px;
    background-color: rgba(12, 12, 18, 0.9);
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.2);
    opacity: 1;
    transition-property: opacity, translate;
    transition-duration: 0.5s;
    transition-timing-function: ease-out;
}

.kill-entry-local {
    background-color: rgba(200, 60, 60, 0.25);
    border-color: rgba(255, 100, 100, 0.4);
}

.kill-entry-fade {
    opacity: 0;
}

.killer-name {
    font-size: 14px;
    color: rgb(240, 240, 240);
    -unity-font-style: bold;
    margin-right: 8px;
    -unity-text-align: middle-right;
}

.killer-name-local {
    color: rgb(255, 200, 100);
}

.kill-icon {
    width: 20px;
    height: 20px;
    min-width: 20px;
    margin-left: 6px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.victim-name {
    font-size: 14px;
    color: rgb(180, 180, 180);
    margin-left: 8px;
    -unity-text-align: middle-left;
}

/* ===== DAMAGE VIGNETTE ===== */

.damage-vignette-container {
    position: absolute;
    left: 0; right: 0;
    top: 0; bottom: 0;
}

.damage-vignette {
    position: absolute;
    background-color: rgba(200, 60, 60, 0.9);
    opacity: 0; /* Controlled by DamageVignetteUI script */
}

/* Damage vignette inline styles merged */
#hit-front,
#hit-back {
    height: 35px;
}

#hit-left,
#hit-right {
    width: 35px;
}

.corner {
    position: absolute;
    width: 12%;
    height: 12%;
    opacity: 0; /* Controlled by DamageVignetteUI script */
}

.corner-c-inline {
    width: 35px;
    height: 35px;
    background-color: rgba(200, 60, 60, 0.9);
}

.corner-c-position-absolute-right-0 {
    position: absolute;
    right: 0;
    width: 35px;
    height: 35px;
    background-color: rgba(200, 60, 60, 0.9);
}

.corner-c-position-absolute-bottom-0-left-0 {
    background-color: rgba(200, 60, 60, 0.9);
    width: 35px;
    height: 35px;
    bottom: 0;
    left: 0;
    position: absolute;
}

.corner-c-position-absolute-bottom-0-right-0 {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 35px;
    height: 35px;
    background-color: rgba(200, 60, 60, 0.9);
}

.corner-h-inline {
    width: 150px;
    height: 35px;
    left: 35px;
}

.corner-h-inline-right-35px {
    right: 35px;
    left: auto;
    width: 150px;
    height: 35px;
}

.corner-h-inline-left-35px {
    width: 150px;
    height: 35px;
    left: 35px;
}

.corner-h-inline-left-auto-right-35px {
    left: auto;
    right: 35px;
    width: 150px;
    height: 35px;
}

.corner-v-inline {
    width: 35px;
    height: 150px;
    top: 35px;
}

.corner-v-inline-top-35px-bottom-auto {
    top: 35px;
    bottom: auto;
    width: 35px;
    height: 150px;
}

.corner-v-inline-bottom-35px-top-auto {
    bottom: 35px;
    width: 35px;
    height: 150px;
    top: auto;
    left: auto;
}

.corner-v-inline-bottom-35px-top-auto-right {
    bottom: 35px;
    top: auto;
    width: 35px;
    height: 150px;
}

#hit-front {
    left: 30%;
    right: 30%;
    top: 0;
    height: 3%;
}

#hit-back {
    left: 30%;
    right: 30%;
    bottom: 0;
    height: 3%;
}

#hit-left {
    left: 0;
    top: 30%;
    bottom: 30%;
    width: 3%;
}

#hit-right {
    right: 0;
    top: 30%;
    bottom: 30%;
    width: 3%;
}


#hit-frontLeft {
    left: 0;
    top: 0;
}

#hit-frontRight {
    right: 0;
    top: 0;
}

#hit-backLeft {
    left: 0;
    bottom: 0;
}

#hit-backRight {
    right: 0;
    bottom: 0;
}

.corner-h {
    position: absolute;
    left: 0;
    right: 40%;
    top: 0;
    height: 3%;
    background-color: rgba(200, 60, 60, 0.9);
}

.corner-v {
    position: absolute;
    top: 0;
    bottom: 40%;
    left: 0;
    width: 3%;
    background-color: rgba(200, 60, 60, 0.9);
}

#hit-frontRight > .corner-h,
#hit-backRight > .corner-h {
    left: 40%;
    right: 0;
}

#hit-frontRight > .corner-v,
#hit-backRight > .corner-v {
    left: auto;
    right: 0;
}

#hit-backLeft > .corner-h,
#hit-backRight > .corner-h {
    top: auto;
    bottom: 0;
}

#hit-backLeft > .corner-v,
#hit-backRight > .corner-v {
    top: 40%;
    bottom: 0;
}

.match-timer-score-container {
    position: absolute;
    top: 24px;
    left: 0;
    right: 0;
    height: 50px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

#match-timer-container {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    padding: 6px 16px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.4);
    background-color: rgba(12, 12, 18, 0.9);
    justify-content: center;
    align-items: center;
}

.match-timer-container-max-width {
    min-width: 112px;
    max-width: 112px;
}

.hud-score-container {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    min-width: 50px;
    min-height: 50px;
    padding: 0;
    border-radius: 4px;
    background-color: rgba(15, 15, 20, 0.9);
    border-width: 1px;
}

.hud-score-your {
    border-color: rgba(100, 150, 255, 0.4);
    background-color: rgba(50, 100, 255, 0.35);
    margin-right: 0;
}

.hud-score-enemy {
    border-color: rgba(255, 100, 100, 0.4);
    background-color: rgba(255, 50, 50, 0.35);
    margin-left: 0;
}

#left-score-container {
    position: absolute;
    right: 50%;
    margin-right: 64px;
}

#right-score-container {
    position: absolute;
    left: 50%;
    margin-left: 64px;
}

.hud-score-value {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
    padding: 0;
    margin: 0;
}

.match-timer-label {
    color: rgb(240, 240, 240);
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.out-of-bounds-countdown-label {
    position: absolute;
    top: 86px;
    left: 50%;
    translate: -50% 0;
    display: none;
    padding: 4px 10px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.45);
    background-color: rgba(12, 12, 18, 0.88);
    color: rgb(255, 220, 220);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.75);
}

/* ===== PODIUM NAMEPLATES ===== */

.podium-nameplates {
    position: absolute;
    width: 100%;
    height: 100%;
    display: none;
}

.podium-nameplates-inline {
    display: none;
    height: 154px;
    top: 926px;
}

.podium-slot {
    position: absolute;
    min-width: 170px;
    padding: 8px 12px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.3);
    background-color: rgba(12, 12, 18, 0.92);
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.podium-slot-first {
    bottom: 18%;
    left: 50%;
    translate: -50% 0;
}

.podium-slot-second {
    bottom: 14%;
    left: 32%;
}

.podium-slot-third {
    bottom: 14%;
    right: 32%;
}

.podium-slot-first-inline {
    min-width: 200px;
    max-width: 200px;
    bottom: 47%;
    left: 49%;
    position: relative;
    min-height: 88px;
    top: -9%;
}

.podium-slot-second-inline {
    bottom: 90%;
    left: 28%;
    min-width: 200px;
    max-width: 200px;
    position: relative;
    min-height: 88px;
}

.podium-slot-third-inline {
    bottom: 100%;
    right: -58%;
    min-width: 200px;
    max-width: 200px;
    position: relative;
    min-height: 88px;
    top: -183%;
}

.podium-kill-icon-inline {
    min-width: 22px;
    width: 22px;
    height: 22px;
}

.podium-kill-icon-inline-alt {
    width: 22px;
    height: 22px;
    min-width: 22px;
}

.podium-name {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
    -unity-text-align: middle-center;
    text-shadow: 0 0 4px rgba(0, 0, 0, 0.7);
    margin-bottom: 2px;
}

.podium-kills-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.podium-kills-text {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 220, 180);
    -unity-text-align: middle-center;
    min-width: 28px;
    margin-right: 4px;
}

.podium-kill-icon {
    width: 18px;
    height: 18px;
    min-width: 18px;
    border-radius: 4px;
    background-image: url("/Assets/UI Toolkit/Images/skull.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* ===== SNIPER OVERLAY ===== */

.sniper-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
}

.sniper-crosshair {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.sniper-crosshair-bar {
    position: absolute;
    background-color: rgba(0, 0, 0, 1);
}

.sniper-crosshair-bar.horizontal {
    width: 100%;
    height: 1px;
    top: 50%;
    left: 0;
    margin-top: -0.5px;
}

.sniper-crosshair-bar.vertical {
    height: 100%;
    width: 1px;
    left: 50%;
    top: 0;
    margin-left: -0.5px;
}

/* ===== CHALLENGE CARDS (Pause Menu) ===== */

/* ===== POST-MATCH XP DISPLAY ===== */
.xp-postmatch-container {
    position: absolute;
    bottom: 20px;
    width: 28%;
    left: 36%;
    background-color: rgba(0, 0, 0, 0.72);
    padding: 6px 12px;
    border-radius: 6px;
    display: none;
    flex-direction: column;
    align-items: center;
}

.xp-level-label {
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
    align-self: center;
    margin-bottom: 2px;
}

.xp-progress-bar {
    height: 8px;
    width: 100%;
}

.xp-progress-bar .unity-progress-bar__container {
    height: 8px;
    min-height: 8px;
    max-height: 8px;
    margin: 0;
    padding: 0;
    background-color: transparent;
}

.xp-progress-bar .unity-progress-bar__background {
    height: 8px;
    min-height: 8px;
    max-height: 8px;
    background-color: rgba(255, 255, 255, 0.25);
    border-width: 0;
    border-radius: 4px;
    margin: 0;
    padding: 0;
}

.xp-progress-bar .unity-progress-bar__progress {
    height: 8px;
    min-height: 8px;
    max-height: 8px;
    background-color: rgb(255, 80, 80);
    border-radius: 4px;
    margin: 0;
    padding: 0;
}

.xp-progress-bar .unity-progress-bar__title-container {
    display: none;
    height: 0;
}

.xp-gained-label {
    color: rgba(51, 255, 51, 1);
    font-size: 14px;
    align-self: center;
    margin-top: 3px;
}

/* ===== CHAT ===== */
.chat-container {
    position: absolute;
    bottom: 110px; /* Above health bar */
    left: 30px;
    width: 340px;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-end;
}

/* Chat background - toggles background/border visibility */
.chat-background {
    width: 100%;
    height: 200px;
    max-height: 200px;
    min-height: 200px;
    background-color: rgba(8, 8, 12, 0.85);
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.5);
    border-radius: 4px 4px 0 0;
    margin: 0 0 4px;
    padding: 0;
    align-self: stretch;
    flex-direction: column;
    overflow: hidden;
}

.chat-background.minimized {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

.chat-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: scroll;
    flex-direction: column;
}

.chat-scroll .unity-scroll-view__content-container {
    justify-content: flex-end;
    min-height: 100%;
}

.chat-scroll .unity-scroll-view__vertical-scroller {
    margin-top: 0;
    margin-bottom: 0;
    height: 100%;
}

.chat-message-list {
    flex-direction: column;
    padding: 8px;
    min-height: 100%;
    justify-content: flex-end;
}

.chat-message {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 3px;
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.8);
    white-space: normal;
    padding: 2px 0;
    background-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 1.5s;
}

.chat-message-row {
    width: 100%;
    max-width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    margin-bottom: 3px;
    background-color: rgba(0, 0, 0, 0);
    border-radius: 0;
}

.chat-message-name {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.95);
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.8);
    margin-right: 2px;
    white-space: nowrap;
    flex-shrink: 0;
}

.chat-message-content {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.8);
    white-space: normal;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    max-width: 100%;
    background-color: rgba(0, 0, 0, 0);
    border-radius: 0;
}

.chat-message-system {
    color: rgb(255, 200, 80);
    -unity-font-style: bold;
    max-width: 100%;
}

.chat-input {
    width: 100%;
    height: 36px;
    background-color: rgba(10, 10, 15, 0.9);
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.5);
    border-radius: 4px;
    color: white;
    font-size: 14px;
    margin: 0;
    padding-left: 2px;
    padding-right: 0;
    align-self: stretch;
    --unity-cursor-color: white;
}
.chat-input.minimized {
    visibility: hidden;
}

.chat-input > .unity-text-field__input {
    background-color: rgba(0,0,0,0);
    border-width: 0;
    margin: 0;
    padding-top: 4px;
    padding-bottom: 4px;
    color: white;
    --unity-cursor-color: white;
}

.chat-input > .unity-text-element--inner-input-field-component {
    padding-top: 4px;
    padding-bottom: 4px;
    --unity-cursor-color: white;
    color: white;
}

.chat-input > .unity-base-text-field__input {
    padding-top: 4px;
    padding-bottom: 4px;
}


.chat-message.fading {
    opacity: 0;
}


/* ===== VOICE CHAT ===== */
.speaking-indicator {
    position: absolute;
    bottom: -4px;
    right: -4px;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: rgb(0, 255, 0);
    border-width: 1px;
    border-color: rgba(0,0,0,0.5);
    display: none;
}
.speaking-indicator.active {
    display: flex;
}


/* ===== VOICE OVERLAY ===== */
.voice-overlay-container {
    display: flex;
    position: absolute;
    top: 15%; /* Discord-Safe Offset */
    left: 20px;
    width: 250px;
    flex-direction: column;
    align-items: flex-start;
}

.voice-entry {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    margin-bottom: 4px;
    background-color: rgba(12, 12, 18, 0.7);
    border-radius: 4px;
    border-left-width: 3px;
    border-left-color: rgb(200, 60, 60); /* Hopball Red */
    opacity: 1;
    transition-duration: 0.2s;
    transition-property: opacity, translate;
}

.voice-entry-avatar {
    width: 24px;
    height: 24px;
    border-radius: 2px;
    margin-right: 8px;
    background-color: rgba(255,255,255,0.1);
}

.voice-entry-name {
    font-size: 14px;
    color: rgb(240, 240, 240);
    -unity-font-style: bold;
}

/* ===== CONTEXT MENU ===== */
.context-menu {
    position: absolute;
    width: 160px;
    background-color: rgba(12, 12, 18, 0.98);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.3);
    padding: 6px 0;
    flex-direction: column;
}

.context-menu-item {
    font-size: 14px;
    color: rgb(220, 220, 220);
    background-color: transparent;
    border-width: 0;
    -unity-text-align: middle-left;
    padding: 8px 12px;
    margin: 0;
    border-radius: 0;
}

.context-menu-item:hover {
    background-color: rgba(255, 100, 100, 0.2);
    color: white;
}

.context-menu-separator {
    height: 1px;
    background-color: rgba(200, 60, 60, 0.2);
    margin: 4px 0;
}

#context-menu-backdrop {
    background-color: rgba(0, 0, 0, 0.01);
}
