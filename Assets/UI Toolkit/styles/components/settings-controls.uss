/* ===== FORM ELEMENTS ===== */
.setting-row {
    flex-direction: row;
    align-items: center;
    min-height: 32px;
    margin-bottom: 12px;
}

.setting-label {
    flex-grow: 1;
    font-size: 14px;
    min-width: 180px;
    color: rgb(220, 220, 220);
}

.value-label {
    font-size: 14px;
    color: rgb(180, 180, 180);
    min-width: 60px;
    -unity-text-align: middle-right;
    margin-left: 10px;
}

.value-label.accent {
    color: rgb(255, 100, 100);
}

/* Value input fields (volume and sensitivity) */
.value-input {
    font-size: 14px;
    color: rgb(240, 240, 240);
    min-width: 60px;
    max-width: 80px;
    -unity-text-align: middle-right;
    margin-left: 10px;
    background-color: transparent;
    border-width: 0;
    --unity-cursor-color: rgb(240, 240, 240);
}

/* Sensitivity input - fixed width to prevent growing */
.value-input.sensitivity-input {
    max-width: 60px;
    width: 60px;
}

.value-input:focus {
    --unity-cursor-color: rgb(240, 240, 240);
}

.value-input > .unity-base-text-field__input {
    --unity-cursor-color: rgb(240, 240, 240);
    background-color: transparent;
    border-width: 0;
}

.value-input:focus > .unity-base-text-field__input {
    --unity-cursor-color: rgb(240, 240, 240);
}

.value-input > .unity-text-element--inner-input-field-component {
    --unity-cursor-color: rgb(240, 240, 240);
    color: rgb(240, 240, 240);
}

.value-input:focus > .unity-text-element--inner-input-field-component {
    --unity-cursor-color: rgb(240, 240, 240);
}

.setting-toggle {
    margin-left: auto;
    width: 20px;
    height: 20px;
    min-width: 20px;
    min-height: 20px;
    max-width: 20px;
    max-height: 20px;
    padding: 0;
    margin: 0;
    background-color: rgba(20, 20, 25, 0.9);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.3);
    -unity-background-image-tint-color: rgba(20, 20, 25, 0.9);
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    transition-duration: 0.2s;
    /* Ensure no background image in unchecked state */
    background-image: none;
    background-size: 12px 12px;
    background-repeat: no-repeat;
    background-position: center;
}

.setting-toggle:hover {
    border-color: rgba(255, 100, 100, 0.5);
    background-color: rgba(25, 25, 30, 0.9);
    -unity-background-image-tint-color: rgba(25, 25, 30, 0.9);
    /* Ensure no background image in unchecked hover state */
    background-image: none;
    background-size: 12px 12px;
}

/* Checked state - show red background and white checkmark */
.setting-toggle.checked {
    background-color: rgba(200, 60, 60, 0.4);
    border-color: rgba(255, 100, 100, 0.6);
    background-image: url('/Assets/UI Toolkit/Images/checkmark.png');
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-size: 12px 12px;
    background-repeat: no-repeat;
    background-position: center;
}

.setting-toggle.checked:hover {
    background-color: rgba(200, 60, 60, 0.5);
    border-color: rgba(255, 100, 100, 0.8);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-size: 12px 12px;
}

/* Completely remove default dropdown styling and apply custom */
.setting-dropdown {
    background-color: rgba(20, 20, 25, 0.9);
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.3);
    border-radius: 4px;
    padding: 4px 8px;
    width: 40%;
    min-width: 40%;
    max-width: 40%;
    color: rgb(240, 240, 240);
    min-height: 24px;
    -unity-background-image-tint-color: rgba(20, 20, 25, 0.9);
    overflow: hidden;
    text-overflow: ellipsis;
}

.setting-dropdown:hover {
    border-color: rgba(255, 100, 100, 0.5);
    background-color: rgba(25, 25, 30, 0.9);
    -unity-background-image-tint-color: rgba(25, 25, 30, 0.9);
}

/* Dropdown input - remove inner white border and default styling */
.setting-dropdown > .unity-base-dropdown__input,
.setting-dropdown .unity-base-dropdown__input {
    background-color: transparent;
    border-width: 0;
    border-color: transparent;
    color: rgb(240, 240, 240);
    padding: 0;
    margin: 0;
    -unity-background-image-tint-color: transparent;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Dropdown arrow - equilateral triangle matching gamemode arrow */
.setting-dropdown > .unity-base-popup-field__arrow,
.setting-dropdown .unity-base-popup-field__arrow {
    width: 0;
    height: 0;
    min-width: 0;
    min-height: 0;
    border-left-width: 7px;
    border-left-color: transparent;
    border-right-width: 7px;
    border-right-color: transparent;
    border-bottom-width: 12px;
    border-bottom-color: rgb(255, 100, 100);
    border-top-width: 0;
    margin-left: 8px;
    margin-right: 4px;
    background-color: transparent;
    -unity-background-image-tint-color: transparent;
}

.setting-dropdown > .unity-base-popup-field__arrow.down,
.setting-dropdown .unity-base-popup-field__arrow.down {
    border-bottom-width: 0;
    border-top-width: 12px;
    border-top-color: rgb(255, 100, 100);
}

/* ===== KEYBIND BUTTONS ===== */
.keybind-button {
    margin-left: 8px;
    width: 120px;
    min-width: 120px;
    max-width: 120px;
    height: 32px;
    min-height: 32px;
    padding: 6px 12px;
    background-color: rgba(20, 20, 25, 0.9);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.3);
    color: rgb(220, 220, 220);
    font-size: 13px;
    -unity-text-align: middle-center;
    transition-duration: 0.2s;
}

.keybind-button:hover {
    border-color: rgba(255, 100, 100, 0.5);
    background-color: rgba(25, 25, 30, 0.9);
    color: rgb(240, 240, 240);
}

.keybind-button:active {
    border-color: rgba(255, 100, 100, 0.7);
    background-color: rgba(30, 30, 35, 0.9);
}

.setting-slider {
    flex-grow: 1;
    max-width: 320px;
    height: 20px;
    min-height: 20px;
}

/* Slider track (background) */
.setting-slider > .unity-base-slider__tracker {
    background-color: rgba(20, 20, 25, 0.9);
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.3);
    border-radius: 4px;
    height: 6px;
    -unity-background-image-tint-color: rgba(20, 20, 25, 0.9);
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

/* Slider fill (filled portion) - red progress bar extending to dragger */
.setting-slider > .unity-base-slider__fill {
    background-color: rgb(255, 100, 100);
    border-radius: 4px;
    height: 6px;
    -unity-background-image-tint-color: rgb(255, 100, 100);
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

/* Slider dragger (handle) */
.setting-slider > .unity-base-slider__dragger {
    background-color: rgb(255, 100, 100);
    border-radius: 50%;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
    max-width: 16px;
    max-height: 16px;
    -unity-background-image-tint-color: rgb(255, 100, 100);
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    transition-duration: 0.15s;
}

/* Dragger hover state */
.setting-slider > .unity-base-slider__dragger:hover {
    background-color: rgb(255, 120, 120);
    border-color: rgba(255, 255, 255, 0.5);
    width: 18px;
    height: 18px;
    min-width: 18px;
    min-height: 18px;
    max-width: 18px;
    max-height: 18px;
}

/* Dragger active/pressed state */
.setting-slider > .unity-base-slider__dragger:active {
    background-color: rgb(200, 60, 60);
    border-color: rgba(255, 255, 255, 0.4);
}
