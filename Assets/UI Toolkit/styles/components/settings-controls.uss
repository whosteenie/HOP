/* ===== FORM ELEMENTS ===== */
.setting-row {
    flex-direction: row;
    align-items: center;
    min-height: 32px;
    margin-bottom: 12px;
}

.setting-label {
    flex-grow: 1;
    font-size: 14px;
    min-width: 180px;
    color: var(--color-text-secondary);
}

.value-label {
    font-size: 14px;
    color: var(--color-text-muted);
    min-width: 60px;
    -unity-text-align: middle-right;
    margin-left: 10px;
}

.value-label.accent {
    color: var(--color-accent);
}

/* Value input fields (volume and sensitivity) */
.value-input {
    font-size: 14px;
    color: var(--color-text-primary);
    min-width: 60px;
    max-width: 80px;
    -unity-text-align: middle-right;
    margin-left: 10px;
    background-color: transparent;
    border-width: 0;
    --unity-cursor-color: var(--cursor-color);
}

/* Sensitivity input - fixed width to prevent growing */
.value-input.sensitivity-input {
    max-width: 60px;
    width: 60px;
}

.value-input:focus {
    --unity-cursor-color: var(--cursor-color);
}

.value-input > .unity-base-text-field__input {
    --unity-cursor-color: var(--cursor-color);
    background-color: transparent;
    border-width: 0;
}

.value-input:focus > .unity-base-text-field__input {
    --unity-cursor-color: var(--cursor-color);
}

.value-input > .unity-text-element--inner-input-field-component {
    --unity-cursor-color: var(--cursor-color);
    color: var(--color-text-primary);
}

.value-input:focus > .unity-text-element--inner-input-field-component {
    --unity-cursor-color: var(--cursor-color);
}

.setting-toggle {
    margin-left: auto;
    width: 20px;
    height: 20px;
    min-width: 20px;
    min-height: 20px;
    max-width: 20px;
    max-height: 20px;
    padding: 0;
    margin: 0;
    background-color: var(--color-bg-surface);
    border-radius: var(--radius-md);
    border-width: 1px;
    border-color: var(--color-accent-border);
    -unity-background-image-tint-color: var(--color-bg-surface);
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    transition-duration: var(--dur-fast);
    /* Ensure no background image in unchecked state */
    background-image: none;
    background-size: 12px 12px;
    background-repeat: no-repeat;
    background-position: center;
}

.setting-toggle:hover {
    border-color: var(--color-accent-border-hover);
    background-color: var(--color-bg-surface-hover);
    -unity-background-image-tint-color: var(--color-bg-surface-hover);
    /* Ensure no background image in unchecked hover state */
    background-image: none;
    background-size: 12px 12px;
}

/* Checked state - show red background and white checkmark */
.setting-toggle.checked {
    background-color: var(--color-accent-bg-mid);
    border-color: var(--color-accent-border-strong);
    background-image: url('/Assets/UI Toolkit/Images/checkmark.png');
    -unity-background-image-tint-color: var(--color-white);
    background-size: 12px 12px;
    background-repeat: no-repeat;
    background-position: center;
}

.setting-toggle.checked:hover {
    background-color: rgba(200, 60, 60, 0.5);
    border-color: var(--color-accent-border-pressed);
    -unity-background-image-tint-color: var(--color-white);
    background-size: 12px 12px;
}

/* Completely remove default dropdown styling and apply custom */
/* Match keybind-button unhover background (--color-bg-surface) */
.setting-dropdown {
    background-color: var(--color-bg-surface);
    border-width: 1px;
    border-color: var(--color-accent-border);
    border-radius: var(--radius-md);
    padding: 4px 8px;
    width: var(--options-dropdown-width, 320px);
    min-width: var(--options-dropdown-width, 320px);
    max-width: var(--options-dropdown-width, 320px);
    color: var(--color-text-primary);
    min-height: 24px;
    -unity-background-image-tint-color: var(--color-bg-surface);
    overflow: hidden;
    text-overflow: ellipsis;
}

.setting-dropdown:hover {
    border-color: var(--color-accent-border-hover);
    background-color: var(--color-bg-surface-hover);
    -unity-background-image-tint-color: var(--color-bg-surface-hover);
}

/* Dropdown input - remove inner white border and default styling */
.setting-dropdown > .unity-base-dropdown__input,
.setting-dropdown .unity-base-dropdown__input {
    background-color: transparent;
    border-width: 0;
    border-color: transparent;
    color: var(--color-text-primary);
    padding: 0;
    margin: 0;
    -unity-background-image-tint-color: transparent;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Dropdown arrow - equilateral triangle matching gamemode arrow */
.setting-dropdown > .unity-base-popup-field__arrow,
.setting-dropdown .unity-base-popup-field__arrow {
    width: 0;
    height: 0;
    min-width: 0;
    min-height: 0;
    border-left-width: 7px;
    border-left-color: transparent;
    border-right-width: 7px;
    border-right-color: transparent;
    border-bottom-width: 0;
    border-top-width: 12px;
    border-top-color: var(--color-accent);
    margin-left: 8px;
    margin-right: 4px;
    background-color: transparent;
    -unity-background-image-tint-color: transparent;
}

/* Opened dropdown: flip arrow up via C#-managed state class. */
.setting-dropdown.dropdown-open > .unity-base-popup-field__arrow,
.setting-dropdown.dropdown-open .unity-base-popup-field__arrow,
.setting-dropdown > .unity-base-popup-field__arrow.down,
.setting-dropdown .unity-base-popup-field__arrow.down {
    border-bottom-width: 12px;
    border-bottom-color: var(--color-accent);
    border-top-width: 0;
}

/* ===== KEYBIND BUTTONS ===== */
.keybind-button {
    margin-left: 8px;
    width: 120px;
    min-width: 120px;
    max-width: 120px;
    height: 32px;
    min-height: 32px;
    padding: 6px 12px;
    background-color: var(--color-bg-surface);
    border-radius: var(--radius-md);
    border-width: 1px;
    border-color: var(--color-accent-border);
    color: var(--color-text-secondary);
    font-size: 13px;
    -unity-text-align: middle-center;
    transition-duration: var(--dur-fast);
}

.keybind-button:hover {
    border-color: var(--color-accent-border-hover);
    background-color: var(--color-bg-surface-hover);
    color: var(--color-text-primary);
}

.keybind-button:active {
    border-color: rgba(255, 100, 100, 0.7);
    background-color: var(--color-bg-surface-pressed);
}

.setting-slider {
    flex-grow: 1;
    max-width: 320px;
    height: 20px;
    min-height: 20px;
}

/* Slider track (background) */
.setting-slider > .unity-base-slider__tracker {
    background-color: var(--color-bg-surface);
    border-width: 1px;
    border-color: var(--color-accent-border);
    border-radius: var(--radius-md);
    height: 6px;
    -unity-background-image-tint-color: var(--color-bg-surface);
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

/* Slider fill (filled portion) - red progress bar extending to dragger */
.setting-slider > .unity-base-slider__fill {
    background-color: var(--color-accent);
    border-radius: var(--radius-md);
    height: 6px;
    -unity-background-image-tint-color: var(--color-accent);
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

/* Slider dragger (handle) */
.setting-slider > .unity-base-slider__dragger {
    background-color: var(--color-accent);
    border-radius: 50%;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
    max-width: 16px;
    max-height: 16px;
    -unity-background-image-tint-color: var(--color-accent);
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    transition-duration: var(--dur-faster);
}

/* Dragger hover state */
.setting-slider > .unity-base-slider__dragger:hover {
    background-color: var(--color-accent-hover);
    border-color: rgba(255, 255, 255, 0.5);
    width: 18px;
    height: 18px;
    min-width: 18px;
    min-height: 18px;
    max-width: 18px;
    max-height: 18px;
}

/* Dragger active/pressed state */
.setting-slider > .unity-base-slider__dragger:active {
    background-color: var(--color-accent-strong);
    border-color: rgba(255, 255, 255, 0.4);
}
