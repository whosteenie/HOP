/* ===== OPTIONS PANEL ===== */
/* Add margin-right to content to create space between content and scrollbar */
.options-content {
    flex-direction: column;
    padding: 10px 0;
    margin-right: 16px;
}

/* ===== OPTIONS TABS ===== */
.options-tabs {
    flex-direction: row;
    margin-top: 20px;
    margin-bottom: 20px;
    align-items: center;
    justify-content: center;
}

.options-tab {
    background-color: transparent;
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    border-top-color: transparent;
    border-left-color: transparent;
    border-right-color: transparent;
    color: rgb(180, 180, 180);
    font-size: 16px;
    -unity-font-style: normal;
    padding: 10px 20px;
    margin-right: 8px;
    transition-duration: 0.2s;
    min-height: 40px;
    width: 120px;
    min-width: 120px;
    max-width: 120px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.options-tab,
.options-tab > .unity-text-element {
    color: rgb(180, 180, 180);
}

.options-tab-hover,
.options-tab-hover > .unity-text-element {
    color: rgb(240, 240, 240);
}

.options-tab-hover {
    border-bottom-color: rgba(200, 60, 60, 0.5);
}

.options-tab-active,
.options-tab-active > .unity-text-element {
    color: rgb(255, 100, 100);
}

.options-tab-active {
    border-bottom-color: rgb(255, 100, 100);
}

.options-content-scroll {
    flex-grow: 1;
    min-height: 300px;
    max-height: 550px;
    height: 550px;
    margin-bottom: 20px;
    border-top-width: 1px;
    border-top-color: rgba(200, 60, 60, 0.3);
    border-bottom-width: 1px;
    border-bottom-color: rgba(200, 60, 60, 0.3);
}

/* Hide scrollbar arrows specifically for options content scroll */
.options-content-scroll .unity-scroller__low-button,
.options-content-scroll .unity-scroller__high-button {
    display: none;
    width: 0;
    height: 0;
    min-width: 0;
    min-height: 0;
    max-width: 0;
    max-height: 0;
    visibility: hidden;
}

/* Options content specific scrollbar tweaks */
.options-content-scroll .unity-scroll-view__vertical-scroller {
    margin-top: 0;
    margin-bottom: 0;
}

.options-tab-content {
    flex-direction: column;
    width: 100%;
}

/* ===== OPTIONS CONTAINER ===== */
.options-container {
    height: 85%;
    min-height: 85%;
    max-height: 85%;
    overflow: hidden;
}
