/* ===== OPTIONS FULLSCREEN LAYOUT ===== */
#options-panel {
    align-items: stretch;
    justify-content: flex-start;
}

.options-container {
    width: 100%;
    height: 100%;
    min-height: 100%;
    max-height: 100%;
    padding: 34px 40px 22px 40px;
    flex-direction: column;
    overflow: hidden;
    background-color: rgba(6, 8, 12, 0.9);
    border-width: 0;
    border-radius: 0;
}

/* Extra readability when options are actively open. */
.options-open #options-panel .options-container {
    background-color: rgba(4, 6, 10, 0.94);
}

/* Keep fullscreen background, but enforce content insets even when screen-level sheets
   also define .options-container. */
#options-panel .options-container {
    height: 100%;
    min-height: 100%;
    max-height: 100%;
    overflow: hidden;
    padding: 34px 40px 22px;
}

.options-header {
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 12px;
}

#options-label {
    margin-bottom: 8px;
}

.options-layout {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.options-main-column {
    flex-direction: column;
    width: 66%;
    min-width: 760px;
    max-width: 1160px;
    height: 100%;
    min-height: 0;
    margin-right: 28px;
}

.options-description-panel {
    flex-grow: 1;
    min-width: 320px;
    padding-left: 24px;
    padding-top: 34px;
    padding-bottom: 22px;
    margin-top: -34px;
    margin-bottom: -22px;
    border-left-width: 1px;
    border-left-color: var(--color-accent-border);
    background-color: rgba(0, 0, 0, 0);
}

.options-description-title {
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--color-accent);
    margin-top: var(--options-description-offset-y);
    margin-bottom: 10px;
}

.options-description-body {
    font-size: 14px;
    color: var(--color-text-secondary);
    white-space: normal;
    -unity-text-align: upper-left;
}

/* ===== OPTIONS TABS ===== */
.options-tabs {
    flex-direction: row;
    margin-top: 8px;
    margin-bottom: 18px;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
}

/* Harden tab layout/styling for templated instances where class-based styling can be lost. */
#options-panel #options-tabs {
    flex-direction: row;
    margin-top: 8px;
    margin-bottom: 18px;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
}

.options-tab {
    background-color: transparent;
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    border-top-color: transparent;
    border-left-color: transparent;
    border-right-color: transparent;
    color: var(--color-text-muted);
    font-size: 20px;
    -unity-font-style: normal;
    padding: 10px 14px;
    margin-right: 16px;
    transition-duration: var(--dur-fast);
    min-height: 48px;
    width: 140px;
    min-width: 140px;
    max-width: 140px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

#options-panel #tab-video,
#options-panel #tab-audio,
#options-panel #tab-game,
#options-panel #tab-controls {
    background-color: transparent;
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    border-top-color: transparent;
    border-left-color: transparent;
    border-right-color: transparent;
    color: var(--color-text-muted);
    font-size: 20px;
    -unity-font-style: normal;
    padding: 10px 14px;
    margin-right: 16px;
    transition-duration: var(--dur-fast);
    min-height: 48px;
    width: 140px;
    min-width: 140px;
    max-width: 140px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.options-tab,
.options-tab > .unity-text-element {
    color: var(--color-text-muted);
}

#options-panel #tab-video > .unity-text-element,
#options-panel #tab-audio > .unity-text-element,
#options-panel #tab-game > .unity-text-element,
#options-panel #tab-controls > .unity-text-element {
    color: var(--color-text-muted);
}

.options-tab-hover,
.options-tab-hover > .unity-text-element {
    color: var(--color-text-primary);
}

.options-tab-hover {
    border-bottom-color: var(--color-accent-border-hover);
}

#options-panel #tab-video.options-tab-hover,
#options-panel #tab-audio.options-tab-hover,
#options-panel #tab-game.options-tab-hover,
#options-panel #tab-controls.options-tab-hover {
    border-bottom-color: var(--color-accent-border-hover);
}

.options-tab-active,
.options-tab-active > .unity-text-element {
    color: var(--color-accent);
}

.options-tab-active {
    border-bottom-color: var(--color-accent);
}

#options-panel #tab-video.options-tab-active,
#options-panel #tab-audio.options-tab-active,
#options-panel #tab-game.options-tab-active,
#options-panel #tab-controls.options-tab-active {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
}

#options-panel #tab-video.options-tab-active > .unity-text-element,
#options-panel #tab-audio.options-tab-active > .unity-text-element,
#options-panel #tab-game.options-tab-active > .unity-text-element,
#options-panel #tab-controls.options-tab-active > .unity-text-element {
    color: var(--color-accent);
}

/* ===== OPTIONS SCROLL AREA ===== */
.options-content-scroll {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    height: 100%;
    max-height: 100%;
    margin-bottom: 16px;
    border-top-width: 1px;
    border-top-color: var(--color-accent-border);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-accent-border);
}

/* Hide scrollbar arrows specifically for options content scroll */
.options-content-scroll .unity-scroller__low-button,
.options-content-scroll .unity-scroller__high-button {
    display: none;
    width: 0;
    height: 0;
    min-width: 0;
    min-height: 0;
    max-width: 0;
    max-height: 0;
    visibility: hidden;
}

/* Options content specific scrollbar tweaks */
.options-content-scroll .unity-scroll-view__vertical-scroller {
    display: flex;
    visibility: visible;
    width: var(--options-scrollbar-width);
    min-width: var(--options-scrollbar-width);
    max-width: var(--options-scrollbar-width);
    margin-top: 0;
    margin-bottom: 0;
}

.options-content-scroll .unity-scroll-view__vertical-scroller.unity-disabled {
    visibility: hidden;
}

.options-content-scroll .unity-scroll-view__vertical-scroller.unity-disabled .unity-base-slider__tracker,
.options-content-scroll .unity-scroll-view__vertical-scroller.unity-disabled .unity-base-slider__dragger {
    background-color: transparent;
    border-width: 0;
    -unity-background-image-tint-color: transparent;
}

.options-content {
    flex-direction: column;
    padding: 14px 4px 14px 0;
    margin-right: 10px;
}

.options-tab-content {
    flex-direction: column;
    width: auto;
}

#apply-container {
    justify-content: flex-start;
    margin-top: 2px;
}

#apply-container .menu-chip {
    margin-left: 0;
    margin-right: 12px;
    min-width: 140px;
    height: 50px;
}

/* ===== OPTIONS ROW ALIGNMENT ===== */
#options-panel {
    --options-control-column-width: 420px;
    --options-slider-track-width: 365px;
    --options-value-input-width: 54px;
    --options-control-gap: 12px;
    --options-slider-value-gap: -15px;
    --options-keybind-button-width: 204px;
    --options-row-height: 56px;
    --options-control-height: 50px;
    --options-toggle-size: 24px;
    --options-dropdown-width: 420px;
    --options-description-offset-y: 182px;
    --options-scrollbar-width: 7px;
}

/* Keep all settings rows on a consistent vertical rhythm. */
#options-panel .setting-row {
    min-height: var(--options-row-height);
    margin-bottom: 0;
    padding-top: 6px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 60, 60, 0.2);
}

#options-panel .setting-label {
    font-size: 18px;
    min-width: 280px;
}

/* Keep the control edge aligned for all single-control rows. */
#options-panel .setting-row > .setting-dropdown-align-right,
#options-panel .setting-row > .setting-toggle {
    margin-left: auto;
    margin-right: 0;
}

/* Dropdown unhover background - match keybind button (--color-bg-surface). */
#options-panel .setting-row > .setting-dropdown {
    background-color: var(--color-bg-surface);
    -unity-background-image-tint-color: var(--color-bg-surface);
}

/* Slider rows: align as one right-side control column (slider + value). */
#options-panel .setting-row > .setting-slider {
    margin-left: auto;
    margin-right: 0;
    width: var(--options-slider-track-width);
    min-width: var(--options-slider-track-width);
    max-width: var(--options-slider-track-width);
    flex-grow: 0;
}

#options-panel .setting-row > .value-input {
    width: var(--options-value-input-width);
    min-width: var(--options-value-input-width);
    max-width: var(--options-value-input-width);
    min-height: var(--options-control-height);
    margin-left: var(--options-slider-value-gap);
    margin-right: 0;
    -unity-text-align: middle-right;
    padding-right: 0;
}

/* Slider row value fields: explicit per-control sizing/spacing to keep
   bar/value alignment consistent across all slider-based settings. */
#options-panel #master-volume-value,
#options-panel #music-volume-value,
#options-panel #sfx-volume-value,
#options-panel #voice-volume-value,
#options-panel #voice-input-volume-value,
#options-panel #shadow-distance-value,
#options-panel #sensitivity-value {
    width: 50px;
    min-width: auto;
    max-width: var(--options-value-input-width);
    margin-left: 5px;
}

#options-panel .setting-row > .value-input > .unity-base-text-field__input,
#options-panel .setting-row > .value-input > .unity-text-element--inner-input-field-component {
    -unity-text-align: middle-right;
    padding-right: 0;
}

/* Keybind rows: keep both buttons inside the same right-side control column. */
#options-panel .setting-row > .keybind-button {
    width: var(--options-keybind-button-width);
    min-width: var(--options-keybind-button-width);
    max-width: var(--options-keybind-button-width);
    height: var(--options-control-height);
    min-height: var(--options-control-height);
    max-height: var(--options-control-height);
    margin-left: 0;
    margin-right: 0;
}

/* Normalize control heights across row types. */
#options-panel .setting-row > .setting-dropdown-align-right {
    height: var(--options-control-height);
    min-height: var(--options-control-height);
    max-height: var(--options-control-height);
}

#options-panel .setting-row > .setting-slider {
    min-height: var(--options-control-height);
}

/* Keep checkbox visual size compact while staying aligned to row rhythm. */
#options-panel .setting-row > .setting-toggle {
    width: var(--options-toggle-size);
    min-width: var(--options-toggle-size);
    max-width: var(--options-toggle-size);
    height: var(--options-toggle-size);
    min-height: var(--options-toggle-size);
    max-height: var(--options-toggle-size);
}

/* First keybind button anchors the pair to the right column edge. */
#options-panel .setting-row > .keybind-button-primary {
    margin-left: auto;
}

/* Second keybind button keeps a consistent internal gap. */
#options-panel .setting-row > .keybind-button-secondary {
    margin-left: var(--options-control-gap);
}
