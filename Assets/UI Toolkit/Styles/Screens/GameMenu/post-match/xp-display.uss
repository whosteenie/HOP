/* ===== POST-MATCH XP DISPLAY ===== */
.xp-postmatch-container {
    position: absolute;
    bottom: 20px;
    width: 28%;
    left: 36%;
    background-color: rgba(0, 0, 0, 0.72);
    padding: 6px 12px;
    border-radius: 6px;
    display: none;
    flex-direction: column;
    align-items: center;
}

.xp-level-label {
    color: var(--color-white);
    font-size: 16px;
    -unity-font-style: bold;
    align-self: center;
    margin-bottom: 2px;
}

.xp-progress-bar {
    height: 8px;
    width: 100%;
}

.xp-progress-bar .unity-progress-bar__container {
    height: 8px;
    min-height: 8px;
    max-height: 8px;
    margin: 0;
    padding: 0;
    background-color: transparent;
}

.xp-progress-bar .unity-progress-bar__background {
    height: 8px;
    min-height: 8px;
    max-height: 8px;
    background-color: rgba(255, 255, 255, 0.25);
    border-width: 0;
    border-radius: 4px;
    margin: 0;
    padding: 0;
}

.xp-progress-bar .unity-progress-bar__progress {
    height: 8px;
    min-height: 8px;
    max-height: 8px;
    background-color: rgb(255, 80, 80);
    border-radius: 4px;
    margin: 0;
    padding: 0;
}

.xp-progress-bar .unity-progress-bar__title-container {
    display: none;
    height: 0;
}

.xp-gained-label {
    color: rgba(51, 255, 51, 1);
    font-size: 14px;
    align-self: center;
    margin-top: 3px;
}

