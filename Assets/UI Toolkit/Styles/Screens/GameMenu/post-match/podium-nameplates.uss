/* ===== PODIUM NAMEPLATES ===== */

.podium-nameplates {
    position: absolute;
    width: 100%;
    height: 100%;
    display: none;
}

.podium-nameplates-inline {
    display: none;
    height: 154px;
    top: 926px;
}

.podium-slot {
    position: absolute;
    min-width: 170px;
    padding: 8px 12px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--color-accent-border);
    background-color: rgba(12, 12, 18, 0.92);
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.podium-slot-first {
    bottom: 18%;
    left: 50%;
    translate: -50% 0;
}

.podium-slot-second {
    bottom: 14%;
    left: 32%;
}

.podium-slot-third {
    bottom: 14%;
    right: 32%;
}

.podium-slot-first-inline {
    min-width: 200px;
    max-width: 200px;
    bottom: 47%;
    left: 49%;
    position: relative;
    min-height: 88px;
    top: -9%;
}

.podium-slot-second-inline {
    bottom: 90%;
    left: 28%;
    min-width: 200px;
    max-width: 200px;
    position: relative;
    min-height: 88px;
}

.podium-slot-third-inline {
    bottom: 100%;
    right: -58%;
    min-width: 200px;
    max-width: 200px;
    position: relative;
    min-height: 88px;
    top: -183%;
}

.podium-kill-icon-inline {
    min-width: 22px;
    width: 22px;
    height: 22px;
}

.podium-kill-icon-inline-alt {
    width: 22px;
    height: 22px;
    min-width: 22px;
}

.podium-name {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--color-text-primary);
    -unity-text-align: middle-center;
    text-shadow: 0 0 4px rgba(0, 0, 0, 0.7);
    margin-bottom: 2px;
}

.podium-kills-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.podium-kills-text {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 220, 180);
    -unity-text-align: middle-center;
    min-width: 28px;
    margin-right: 4px;
}

.podium-kill-icon {
    width: 18px;
    height: 18px;
    min-width: 18px;
    border-radius: 4px;
    background-image: url("/Assets/UI Toolkit/Images/skull.png");
    -unity-background-scale-mode: scale-to-fit;
}

