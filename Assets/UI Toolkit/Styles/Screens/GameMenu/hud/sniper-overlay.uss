/* ===== SNIPER OVERLAY ===== */

.sniper-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
}

.sniper-crosshair {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.sniper-crosshair-bar {
    position: absolute;
    background-color: var(--color-shadow-solid);
}

.sniper-crosshair-bar.horizontal {
    width: 100%;
    height: 1px;
    top: 50%;
    left: 0;
    margin-top: -0.5px;
}

.sniper-crosshair-bar.vertical {
    height: 100%;
    width: 1px;
    left: 50%;
    top: 0;
    margin-left: -0.5px;
}

