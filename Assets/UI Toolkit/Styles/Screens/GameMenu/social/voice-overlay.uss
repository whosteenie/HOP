/* ===== VOICE OVERLAY ===== */
.voice-overlay-container {
    display: flex;
    position: absolute;
    top: 15%; /* Discord-Safe Offset */
    left: 20px;
    width: 250px;
    flex-direction: column;
    align-items: flex-start;
}

.voice-entry {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    margin-bottom: 4px;
    background-color: rgba(12, 12, 18, 0.7);
    border-radius: 4px;
    border-left-width: 3px;
    border-left-color: var(--color-accent-strong); /* Hopball Red */
    opacity: 1;
    transition-duration: 0.2s;
    transition-property: opacity, translate;
}

.voice-entry-avatar {
    width: 24px;
    height: 24px;
    border-radius: 2px;
    margin-right: 8px;
    background-color: rgba(255,255,255,0.1);
}

.voice-entry-name {
    font-size: 14px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
}
