/* ===== VOICE CHAT ===== */
.speaking-indicator {
    position: absolute;
    bottom: -4px;
    right: -4px;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: rgb(0, 255, 0);
    border-width: 1px;
    border-color: rgba(0,0,0,0.5);
    display: none;
}
.speaking-indicator.active {
    display: flex;
}


