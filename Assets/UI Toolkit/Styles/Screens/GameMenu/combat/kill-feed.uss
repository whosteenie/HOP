/* ===== KILL FEED ===== */

.kill-feed-container {
    position: absolute;
    top: 30px;
    right: 30px;
    width: 350px;
    flex-direction: column;
    align-items: flex-end;
    justify-content: flex-start;
}

.kill-entry {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding: 8px 12px;
    margin-bottom: 6px;
    border-radius: 4px;
    background-color: var(--color-bg-card-soft);
    border-width: 1px;
    border-color: var(--color-accent-border-soft);
    opacity: 1;
    transition-property: opacity, translate;
    transition-duration: 0.5s;
    transition-timing-function: ease-out;
}

.kill-entry-local {
    background-color: rgba(200, 60, 60, 0.25);
    border-color: var(--color-accent-border-mid);
}

.kill-entry-fade {
    opacity: 0;
}

.killer-name {
    font-size: 14px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    margin-right: 8px;
    -unity-text-align: middle-right;
}

.killer-name-local {
    color: rgb(255, 200, 100);
}

.kill-icon {
    width: 20px;
    height: 20px;
    min-width: 20px;
    margin-left: 6px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.victim-name {
    font-size: 14px;
    color: var(--color-text-muted);
    margin-left: 8px;
    -unity-text-align: middle-left;
}

