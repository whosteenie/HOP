/* ===== LANDING ===== */

#main-menu-panel { /* already uses .panel .full-abs */ }

.main-title {
    position: absolute;
    top: 93px;
    left: 95px;
    font-size: 240px;
    -unity-font-definition: url('project://database/Assets/TextMesh%20Pro/Examples%20&%20Extras/Fonts/Roboto-Bold%20SDF.asset?fileID=11400000&guid=2b4e604fe6152104d97432c733e17021&type=2#Roboto-Bold SDF');
    text-shadow: -1.2px 0 12px var(--color-accent-bg-mid);
}

.main-actions {
    position: absolute; left: 8%; bottom: 10%;
    flex-direction: column;
    overflow: visible;
}

#main-menu-container {
    bottom: 110px;
    left: 109px;
    overflow: visible;
}

.main-menu-challenges-container {
    position: absolute;
    right: 20px;
    bottom: 20px;
    width: 300px;
    flex-direction: column;
    align-items: flex-end;
}

.main-menu-challenges-card--daily {
    margin-bottom: 10px;
}

#play-button-matchmaking {
    font-size: 56px;
}

#loadout-button,
#options-button,
#credits-button,
#quit-button {
    font-size: 34px;
}

/* Text-only buttons with red accent */
.text-button {
    background-color: var(--color-bg-transparent); border-width: 0;
    color: rgb(240,240,240);
    -unity-font-definition: url('project://database/Assets/Open%20Sans/static/OpenSans-SemiBold%20SDF.asset');
    font-size: 36px; -unity-font-style: bold; -unity-text-align: middle-left;
    text-shadow: 0 2px 5px var(--color-shadow-solid);
    padding: 3px 0;
    min-height: 0;
    overflow: visible;
    transition-duration: 0.2s;
}
.text-button:hover:enabled  { 
    color: var(--color-accent); 
    text-shadow: 0 0 8px var(--color-accent-border-strong);
}
.text-button:active:enabled { color: var(--color-accent-strong); }
.text-button:disabled {
    color: var(--color-text-disabled);
}

.menu-entry { flex-direction: row; align-items: center; margin-bottom: 6px; overflow: visible; }

/* Primary action buttons (Play, Private Match) - larger and more prominent */
.primary-action {
    font-size: 48px;
    letter-spacing: 3px;
    text-shadow: 0 3px 6px var(--color-shadow-solid);
    margin-bottom: 4px;
}

.primary-action:hover:enabled {
    color: var(--color-accent-hover);
}

#play-button-matchmaking:disabled:hover {
    color: var(--color-text-disabled);
    text-shadow: 0 2px 5px var(--color-shadow-solid);
}

