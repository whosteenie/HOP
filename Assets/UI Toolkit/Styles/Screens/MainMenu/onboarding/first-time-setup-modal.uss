/* ===== FIRST TIME SETUP MODAL ===== */

.modal-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.9);
    align-items: center;
    justify-content: center;
}

.modal-overlay-top-0-left-0 {
    top: 0;
    left: 0;
}

.first-time-setup-container {
    width: 500px;
    padding: 40px;
    flex-direction: column;
    align-items: center;
}

.first-time-setup-container-min-height {
    min-height: 350px;
}

.first-time-inputs {
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 30px;
    margin-bottom: 30px;
}

.first-time-inputs-inline {
    margin-top: 20px;
    margin-bottom: 54px;
}

.first-time-color-container {
    flex-direction: row;
    align-items: center;
    margin-right: 20px;
    position: relative;
}

.first-time-color-container-margin-10px {
    margin-right: 10px;
}

.first-time-color-options {
    position: absolute;
    top: 0;
    right: 42px;
    flex-direction: column;
    align-items: center;
    background-color: rgba(15, 15, 20, 0.98);
    padding: 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--color-accent-border);
}

.first-time-color-options .color-circle {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    border-color: var(--color-black);
}

.first-time-color-options .color-circle:hover {
    border-color: var(--color-black);
}

.first-time-color-circle-24px {
    width: 24px;
    height: 24px;
    border-color: var(--color-black);
}

.first-time-color-options-inline {
    left: -9px;
    right: auto;
    min-width: 40px;
    justify-content: space-evenly;
    top: 30px;
    min-height: 215px;
    padding: 5px;
}

.first-time-name-input {
    width: 320px;
    height: 50px;
    font-size: 18px;
    padding: 10px 15px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--color-accent-border);
    background-color: var(--color-bg-surface);
    color: var(--color-text-primary);
    -unity-text-align: middle-left;
    --unity-cursor-color: var(--cursor-color);
    transition-duration: 0.2s;
}

.first-time-name-input > .unity-base-text-field__input {
    --unity-cursor-color: var(--cursor-color);
}

.first-time-name-input > .unity-text-element--inner-input-field-component {
    --unity-cursor-color: var(--cursor-color);
}

.first-time-name-input-height-68px {
    height: 68px;
}

.first-time-name-input:hover {
    border-color: rgba(255, 100, 100, 0.5);
    background-color: var(--color-bg-surface-hover);
}

.first-time-name-input:focus {
    border-color: var(--color-accent-border-strong);
    background-color: var(--color-bg-panel-strong);
}

.continue-button {
    width: 150px;
    height: 50px;
}

.color-0 { background-color: var(--color-white); }
.color-1 { background-color: rgb(255, 0, 0); }
.color-2 { background-color: rgb(255, 165, 0); }
.color-3 { background-color: rgb(255, 255, 0); }
.color-4 { background-color: rgb(0, 255, 0); }
.color-5 { background-color: rgb(0, 0, 255); }
.color-6 { background-color: rgb(128, 0, 128); }

.current-color-display {
    position: relative;
    width: 32px;
    height: 32px;
}

.current-color-display .color-circle {
    position: absolute;
    top: 0;
    left: 0;
}

