/* ===== UNITY CONTROL OVERRIDES ===== */
/* Hide scrollbar arrows (up/down buttons) */
.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
    width: 0;
    height: 0;
    visibility: hidden;
}

/* Global Thin Vertical Scroller */
.unity-scroller--vertical,
.unity-scroll-view__vertical-scroller,
.unity-scroll-view__vertical-scrollbars {
    width: 6px;
    margin: 0;
    padding: 0;
    height: 100%;
}

.unity-scroller--vertical .unity-scroller__slider {
    margin: 0;
    width: 6px;
    min-width: 6px;
}

.unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 0;
}

.unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--color-accent);
    border-radius: var(--radius-sm);
    width: 6px;
    left: 0;
    border-width: 0;
    -unity-background-image-tint-color: rgba(0, 0, 0, 0);
}

ScrollView .unity-scroll-view__horizontal-scrollbars,
.unity-scroll-view__horizontal-scrollbars {
    margin-bottom: 12px;
}

/* Remove default Unity slider styling */
.unity-base-slider {
    background-color: transparent;
    -unity-background-image-tint-color: transparent;
}

.unity-base-slider__tracker {
    background-color: var(--color-bg-surface);
    border-width: 1px;
    border-color: var(--color-accent-border);
    -unity-background-image-tint-color: var(--color-bg-surface);
}

.unity-base-slider__fill {
    background-color: var(--color-accent);
    -unity-background-image-tint-color: var(--color-accent);
}

.unity-base-slider__dragger {
    background-color: var(--color-accent);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
    -unity-background-image-tint-color: var(--color-accent);
}

/* Global checkbox overrides - remove all default white styling */
.unity-toggle {
    background-color: transparent;
    -unity-background-image-tint-color: transparent;
}

.unity-toggle__input {
    background-color: var(--color-bg-surface);
    border-width: 1px;
    border-color: var(--color-accent-border);
    border-radius: var(--radius-md);
    -unity-background-image-tint-color: var(--color-bg-surface);
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.unity-toggle__input:checked {
    background-color: var(--color-accent-bg-mid);
    border-color: var(--color-accent-border-strong);
    -unity-background-image-tint-color: var(--color-accent-bg-mid);
}

/* Global checkmark styling - tint the icon red, not a background color */
.unity-toggle__checkmark {
    background-color: transparent;
    -unity-background-image-tint-color: var(--color-accent);
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

/* Force remove white backgrounds from all Unity base components */
.unity-base-field {
    background-color: transparent;
}

.unity-base-field__input {
    background-color: transparent;
    border-width: 0;
}

.unity-base-text-field__input-placeholder {
    color: rgba(150, 150, 150, 0.6);
}

.unity-text-element--inner-input-field-component {
    color: var(--color-text-primary);
}
