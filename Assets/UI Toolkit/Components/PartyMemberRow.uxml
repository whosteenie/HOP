<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="party-member-row" class="party-member-row" picking-mode="Position">
        <ui:VisualElement name="avatar-box" class="steam-avatar" picking-mode="Ignore" />
        <ui:VisualElement name="name-container" class="party-member-name-container" picking-mode="Ignore">
            <ui:Label text="Player Name" name="player-name-label" class="player-name-label" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="host-icon" class="host-icon hidden" picking-mode="Ignore" />
        <ui:VisualElement name="local-xp-row" class="local-xp-row hidden" picking-mode="Ignore">
            <ui:ProgressBar name="local-xp-bar" title="" low-value="0" high-value="100" value="0" class="mainmenu-xp-bar local-xp-bar" />
            <ui:Label text="LVL 1" name="local-level-label" class="local-level-label" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
