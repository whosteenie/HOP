<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/SharedStyles.uss?fileID=7433441132597879392&amp;guid=94b07ae9f6dfe3447bec848c3f2b4d36&amp;type=3#SharedStyles"/>
    <Style src="project://database/Assets/UI%20Toolkit/MainMenu.uss?fileID=7433441132597879392&amp;guid=6386da34af0d5d145aefc4dcab362169&amp;type=3#MainMenu"/>
    
    <ui:Template name="SharedOptionsPanel" src="project://database/Assets/UI%20Toolkit/Components/OptionsPanel.uxml"/>
    <ui:VisualElement name="ui-overlay" picking-mode="Ignore" class="ui-overlay">
        <ui:VisualElement name="voice-overlay-container" picking-mode="Ignore" class="voice-overlay-container"/>
    </ui:VisualElement>
    <ui:VisualElement name="player-model-background" picking-mode="Ignore" class="player-model-background"/>
    <ui:VisualElement name="main-menu-panel" picking-mode="Ignore" class="panel full-abs">
        <ui:Label text="HOP" name="title-label" class="title title-xl main-title"/>
        <ui:VisualElement name="main-menu-container" class="menu-container main-actions">
            <ui:VisualElement class="menu-entry">
                <ui:Button text="PLAY" name="play-button-matchmaking" class="text-button primary-action"/>
            </ui:VisualElement>
            <ui:VisualElement class="menu-entry">
                <ui:Button text="LOADOUT" name="loadout-button" class="text-button"/>
            </ui:VisualElement>
            <ui:VisualElement class="menu-entry">
                <ui:Button text="OPTIONS" name="options-button" class="text-button"/>
            </ui:VisualElement>
            <ui:VisualElement class="menu-entry">
                <ui:Button text="CREDITS" name="credits-button" class="text-button"/>
            </ui:VisualElement>
            <ui:VisualElement class="menu-entry">
                <ui:Button text="QUIT" name="quit-button" class="text-button back-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="main-menu-challenges-container" class="main-menu-challenges-container"/>
    </ui:VisualElement>
    <ui:VisualElement name="play-gamemode-panel" picking-mode="Ignore" class="panel full-abs hidden">
        <ui:Label text="SELECT GAMEMODE" name="gamemode-title" class="title title-l gamemode-selection-header"/>
        <ui:VisualElement name="gamemode-layout-row" class="gamemode-layout-row">
            <ui:VisualElement name="gamemode-cards-container" class="gamemode-cards-scroll">
                <ui:Button name="card-deathmatch" class="gamemode-card">
                    <ui:VisualElement class="gamemode-card-image dm-image"/>
                    <ui:Label text="DEATHMATCH" class="gamemode-card-title"/>
                    <ui:Label text="Free-for-all combat. First to reach the score limit wins." class="gamemode-card-desc"/>
                </ui:Button>
                <ui:Button name="card-team-deathmatch" class="gamemode-card">
                    <ui:VisualElement class="gamemode-card-image tdm-image"/>
                    <ui:Label text="TEAM DEATHMATCH" class="gamemode-card-title"/>
                    <ui:Label text="Two teams battle for supremacy. Work together to win." class="gamemode-card-desc"/>
                </ui:Button>
                <ui:Button name="card-hopball" class="gamemode-card">
                    <ui:VisualElement class="gamemode-card-image hopball-image"/>
                    <ui:Label text="HOPBALL" class="gamemode-card-title"/>
                    <ui:Label text="Race for the Hopball. Hold it to drain energy and score - then run for your life." class="gamemode-card-desc"/>
                </ui:Button>
                <ui:Button name="card-koth" class="gamemode-card">
                    <ui:VisualElement class="gamemode-card-image koth-image"/>
                    <ui:Label text="KING OF THE HILL" class="gamemode-card-title"/>
                    <ui:Label text="Capture and hold the objective to earn points." class="gamemode-card-desc"/>
                </ui:Button>
                <ui:Button name="card-gun-tag" class="gamemode-card">
                    <ui:VisualElement class="gamemode-card-image tag-image"/>
                    <ui:Label text="GUN TAG" class="gamemode-card-title"/>
                    <ui:Label text="High-stakes Tag. One hit and you&apos;re IT. Keep your eyes peeled!" class="gamemode-card-desc"/>
                </ui:Button>
                <ui:VisualElement name="gamemode-side-actions-stack" class="gamemode-side-actions-stack">
                    <ui:Button name="gamemode-private-match-button" class="gamemode-side-action-card gamemode-side-action-first">
                        <ui:Label text="PRIVATE MATCH" class="gamemode-side-action-title"/>
                        <ui:Label text="Start a custom private session." class="gamemode-side-action-desc"/>
                    </ui:Button>
                    <ui:Button name="gamemode-wip-button" class="gamemode-side-action-card">
                        <ui:Label text="WIP" class="gamemode-side-action-title"/>
                        <ui:Label text="Reserved for future mode flow." class="gamemode-side-action-desc"/>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="gamemode-back-row" class="button-row">
            <ui:Button text="BACK" name="back-gamemodes-to-main" class="menu-chip menu-chip-enabled back-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="private-match-setup-panel" picking-mode="Ignore" class="panel full-abs hidden">
        <ui:Label text="PRIVATE MATCH SETUP" name="private-match-setup-title" class="title title-l private-match-setup-header"/>
        <ui:VisualElement name="private-match-setup-container" class="private-match-setup-container">
            <ui:VisualElement class="private-match-settings-column">
                <ui:ScrollView name="private-match-settings-scroll" class="private-match-settings-scroll">
                    <ui:VisualElement name="private-match-settings-content" class="private-match-settings-content">
                        <ui:VisualElement class="setting-row">
                            <ui:Label text="GAMEMODE" class="setting-label"/>
                            <ui:DropdownField name="private-match-gamemode-dropdown" class="options-dropdown private-match-dropdown"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="setting-row">
                            <ui:Label text="MAP" class="setting-label"/>
                            <ui:DropdownField name="private-match-map-dropdown" class="options-dropdown private-match-dropdown"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="setting-row">
                            <ui:Label text="MATCH TIMER (SECONDS)" class="setting-label"/>
                            <ui:IntegerField name="private-match-timer-input" value="600" class="value-input private-match-input"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="private-match-prematch-countdown-row" class="setting-row">
                            <ui:Label text="PRE-MATCH COUNTDOWN" class="setting-label"/>
                            <ui:Button name="private-match-prematch-countdown-toggle" class="setting-toggle"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="private-match-swap-on-death-row" class="setting-row">
                            <ui:Label text="SWAP LOADOUT ON DEATH" class="setting-label"/>
                            <ui:Button name="private-match-swap-on-death-toggle" class="setting-toggle"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="private-match-score-row" class="setting-row">
                            <ui:Label text="SCORE TO WIN" class="setting-label"/>
                            <ui:IntegerField name="private-match-score-input" value="50" class="value-input private-match-input"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="private-match-koth-speed-row" class="setting-row hidden">
                            <ui:Label text="HILL MOVE SPEED" class="setting-label"/>
                            <ui:SliderInt name="private-match-koth-speed-slider" low-value="50" high-value="300" value="100" fill="true" class="setting-slider private-match-koth-speed-slider"/>
                            <ui:Label name="private-match-koth-speed-value" text="1.00x" class="private-match-multiplier-value"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="private-match-tagged-row" class="setting-row">
                            <ui:Label text="TAGGED PLAYERS" class="setting-label"/>
                            <ui:IntegerField name="private-match-tagged-input" value="1" class="value-input private-match-input"/>
                        </ui:VisualElement>
                        <ui:Label text="" name="private-match-validation-label" class="private-match-status-label"/>
                    </ui:VisualElement>
                </ui:ScrollView>
                <ui:VisualElement name="private-match-map-preview-container" class="private-match-map-preview-container">
                    <ui:VisualElement name="private-match-map-preview-image" class="private-match-map-preview-image">
                        <ui:Label text="WIP" name="private-match-map-preview-wip" class="private-match-map-preview-wip"/>
                        <ui:Label text="UNKNOWN MAP" name="private-match-map-preview-title" class="private-match-map-preview-title"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="private-match-preview-column">
                <ui:VisualElement name="private-match-preview-ffa" class="private-match-preview-card">
                    <ui:ScrollView name="private-match-ffa-list" class="private-match-roster-list"/>
                </ui:VisualElement>
                <ui:VisualElement name="private-match-preview-teams" class="private-match-preview-card hidden">
                    <ui:ScrollView name="private-match-team-a-list" class="private-match-roster-list"/>
                    <ui:Label text="VS" class="private-match-vs-label"/>
                    <ui:ScrollView name="private-match-team-b-list" class="private-match-roster-list"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="private-match-setup-buttons">
            <ui:Button text="BACK" name="private-match-back-button" class="menu-chip menu-chip-enabled back-button"/>
            <ui:Button text="START MATCH" name="private-match-start-button" class="menu-chip menu-chip-enabled"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="loadout-panel" class="panel full-abs center-xy hidden">
        <ui:VisualElement name="name-flex">
            <ui:VisualElement name="name-buttons-container" class="loadout-edge-container name-buttons-container">
                <ui:VisualElement name="loadout-bottom-center-controls" class="loadout-bottom-center-controls">
                    <ui:Button text="CAREER" name="career-toggle-button" class="menu-chip menu-chip-enabled loadout-stats-toggle-button"/>
                    <ui:VisualElement name="name-input-container" class="name-input-container">
                        <ui:Label text=" " name="player-name-label" class="player-name-input" picking-mode="Ignore"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="loadout-bottom-left-buttons" class="loadout-bottom-left-buttons button-row">
                    <ui:Button text="BACK" name="back-to-main-from-loadout" class="menu-chip menu-chip-enabled back-button"/>
                    <ui:Button text="APPLY" name="apply-loadout-button" class="menu-chip menu-chip-enabled apply-loadout-button"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="customization-flex">
            <ui:VisualElement name="customization-container" class="loadout-edge-container customization-container card">
                <ui:VisualElement name="customization-content" class="customization-content">
                    <ui:VisualElement name="color-section" class="customization-section">
                        <ui:Label text="COLOR" name="color-section-label" class="section-title"/>
                        <ui:VisualElement name="color-picker-container" class="color-picker-full-container">
                            <ui:Button name="color-preview-box" class="color-preview-box color-preview-button"/>
                            <ui:VisualElement name="color-rgb-inputs" class="color-rgb-container">
                                <ui:VisualElement name="color-r-input-container" class="setting-row">
                                    <ui:Label text="R" name="color-r-label" class="setting-label color-rgb-label"/>
                                    <ui:Slider name="color-r-slider" low-value="0" high-value="255" fill="true" class="setting-slider"/>
                                    <ui:IntegerField name="color-r-input" value="255" max-length="3" class="value-input color-rgb-input"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="color-g-input-container" class="setting-row">
                                    <ui:Label text="G" name="color-g-label" class="setting-label color-rgb-label"/>
                                    <ui:Slider name="color-g-slider" low-value="0" high-value="255" fill="true" class="setting-slider"/>
                                    <ui:IntegerField name="color-g-input" value="255" max-length="3" class="value-input color-rgb-input"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="color-b-input-container" class="setting-row">
                                    <ui:Label text="B" name="color-b-label" class="setting-label color-rgb-label"/>
                                    <ui:Slider name="color-b-slider" low-value="0" high-value="255" fill="true" class="setting-slider"/>
                                    <ui:IntegerField name="color-b-input" value="255" max-length="3" class="value-input color-rgb-input"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="material-section" class="customization-section">
                        <ui:Label text="MATERIAL" name="material-section-label" class="section-title"/>
                        <ui:VisualElement name="smoothness-container" class="setting-row">
                            <ui:Label text="SMOOTHNESS" name="smoothness-label" class="setting-label"/>
                            <ui:Slider name="smoothness-slider" low-value="0" high-value="1" fill="true" class="setting-slider"/>
                            <ui:TextField name="smoothness-value" value="0.50" max-length="4" class="value-input"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="metallic-container" class="setting-row">
                            <ui:Label text="METALLIC" name="metallic-label" class="setting-label"/>
                            <ui:Slider name="metallic-slider" low-value="0" high-value="1" fill="true" class="setting-slider"/>
                            <ui:TextField name="metallic-value" value="0.00" max-length="4" class="value-input"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="height-container" class="setting-row">
                            <ui:Label text="HEIGHT" name="height-label" class="setting-label"/>
                            <ui:Slider name="height-slider" low-value="0.005" high-value="0.08" fill="true" class="setting-slider"/>
                            <ui:TextField name="height-value" value="0.02" max-length="5" class="value-input"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="emission-container" class="customization-section emission-section">
                            <ui:VisualElement name="emission-header" class="emission-header">
                                <ui:Label text="GLOW" name="emission-label" class="section-title emission-title"/>
                            </ui:VisualElement>
                            <ui:Toggle text="ENABLE" name="emission-toggle" class="emission-toggle"/>
                            <ui:VisualElement name="emission-picker-container" class="color-picker-full-container emission-picker">
                                <ui:Button name="emission-preview-box" class="color-preview-box emission-preview-box"/>
                                <ui:VisualElement name="emission-rgb-inputs" class="color-rgb-container emission-rgb-container">
                                    <ui:VisualElement name="emission-r-input-container" class="setting-row">
                                        <ui:Label text="R" name="emission-r-label" class="setting-label color-rgb-label"/>
                                        <ui:Slider name="emission-r-slider" low-value="0" high-value="255" fill="true" class="setting-slider"/>
                                        <ui:IntegerField name="emission-r-input" value="0" max-length="3" class="value-input color-rgb-input"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="emission-g-input-container" class="setting-row">
                                        <ui:Label text="G" name="emission-g-label" class="setting-label color-rgb-label"/>
                                        <ui:Slider name="emission-g-slider" low-value="0" high-value="255" fill="true" class="setting-slider"/>
                                        <ui:IntegerField name="emission-g-input" value="0" max-length="3" class="value-input color-rgb-input"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="emission-b-input-container" class="setting-row">
                                        <ui:Label text="B" name="emission-b-label" class="setting-label color-rgb-label"/>
                                        <ui:Slider name="emission-b-slider" low-value="0" high-value="255" fill="true" class="setting-slider"/>
                                        <ui:IntegerField name="emission-b-input" value="0" max-length="3" class="value-input color-rgb-input"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="weapons-flex">
            <ui:VisualElement name="weapon-selection-container" class="loadout-edge-container weapon-selection-container card">
                <ui:VisualElement name="primary-weapon-container" class="weapon-slot-container-vertical">
                    <ui:VisualElement name="primary-weapon-row" class="weapon-slot-row">
                        <ui:VisualElement name="primary-weapon-slot" class="weapon-slot weapon-slot-primary">
                            <ui:Image name="primary-weapon-image" class="weapon-image"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="primary-dropdown" class="weapon-dropdown hidden">
                            <ui:ScrollView name="primary-scroll" class="weapon-dropdown-scroll weapon-dropdown-scroll-horizontal"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="PRIMARY" class="weapon-slot-label"/>
                </ui:VisualElement>
                <ui:VisualElement name="secondary-weapon-container" class="weapon-slot-container-vertical">
                    <ui:VisualElement name="secondary-weapon-row" class="weapon-slot-row">
                        <ui:VisualElement name="secondary-weapon-slot" class="weapon-slot weapon-slot-secondary">
                            <ui:Image name="secondary-weapon-image" class="weapon-image"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="secondary-dropdown" class="weapon-dropdown hidden">
                            <ui:ScrollView name="secondary-scroll" class="weapon-dropdown-scroll weapon-dropdown-scroll-horizontal"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="SECONDARY" class="weapon-slot-label"/>
                </ui:VisualElement>
                <ui:VisualElement name="tertiary-weapon-container" class="weapon-slot-container-vertical">
                    <ui:VisualElement name="tertiary-weapon-row" class="weapon-slot-row">
                        <ui:VisualElement name="tertiary-weapon-slot" class="weapon-slot weapon-slot-tertiary">
                            <ui:Image name="tertiary-weapon-image" class="weapon-image"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="tertiary-dropdown" class="weapon-dropdown hidden">
                            <ui:ScrollView name="tertiary-scroll" class="weapon-dropdown-scroll weapon-dropdown-scroll-horizontal"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="TERTIARY" class="weapon-slot-label"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="stats-container" class="loadout-edge-container loadout-stats-container card hidden">
            <ui:Label text="CAREER Stats" class="title"/>
            <ui:VisualElement class="loadout-stats-level-row">
                <ui:Label text="LEVEL 1" name="stats-level-label" class="loadout-stats-level-label"/>
            </ui:VisualElement>
            <ui:ProgressBar name="stats-xp-bar" class="loadout-stats-xp-bar" low-value="0" high-value="100" value="0"/>
            <ui:Label text="0 / 100 XP" name="stats-xp-text" class="loadout-stats-xp-text"/>
            <ui:VisualElement class="loadout-stats-grid">
                <ui:VisualElement class="loadout-stat-row">
                    <ui:Label text="Kills" class="loadout-stat-label"/>
                    <ui:Label text="0" name="stats-kills" class="loadout-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="loadout-stat-row">
                    <ui:Label text="Deaths" class="loadout-stat-label"/>
                    <ui:Label text="0" name="stats-deaths" class="loadout-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="loadout-stat-row">
                    <ui:Label text="KDR" class="loadout-stat-label"/>
                    <ui:Label text="0.00" name="stats-kdr" class="loadout-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="loadout-stat-row">
                    <ui:Label text="Highest Killstreak" class="loadout-stat-label"/>
                    <ui:Label text="0" name="stats-streak" class="loadout-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="loadout-stat-row">
                    <ui:Label text="Accuracy" class="loadout-stat-label"/>
                    <ui:Label text="0%" name="stats-accuracy" class="loadout-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="loadout-stat-row">
                    <ui:Label text="Wins" class="loadout-stat-label"/>
                    <ui:Label text="0" name="stats-wins" class="loadout-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="loadout-stat-row">
                    <ui:Label text="Losses" class="loadout-stat-label"/>
                    <ui:Label text="0" name="stats-losses" class="loadout-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="loadout-stat-row">
                    <ui:Label text="OOB Deaths" class="loadout-stat-label"/>
                    <ui:Label text="0" name="stats-oob" class="loadout-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="loadout-stat-row">
                    <ui:Label text="Grapples" class="loadout-stat-label"/>
                    <ui:Label text="0" name="stats-grapples" class="loadout-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="loadout-stat-row">
                    <ui:Label text="Jump Pads" class="loadout-stat-label"/>
                    <ui:Label text="0" name="stats-jumppads" class="loadout-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="loadout-stat-row">
                    <ui:Label text="Airtime" class="loadout-stat-label"/>
                    <ui:Label text="00:00" name="stats-airtime" class="loadout-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="loadout-stat-row">
                    <ui:Label text="Playtime" class="loadout-stat-label"/>
                    <ui:Label text="00:00:00" name="stats-playtime" class="loadout-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="loadout-stat-row">
                    <ui:Label text="Avg Speed" class="loadout-stat-label"/>
                    <ui:Label text="0.0 m/s" name="stats-speed" class="loadout-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="loadout-stat-row">
                    <ui:Label text="Ball Time" class="loadout-stat-label"/>
                    <ui:Label text="00:00" name="stats-balltime" class="loadout-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="loadout-stat-row">
                    <ui:Label text="Hill Time" class="loadout-stat-label"/>
                    <ui:Label text="00:00" name="stats-hilltime" class="loadout-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="loadout-stat-row">
                    <ui:Label text="Time Tagged" class="loadout-stat-label"/>
                    <ui:Label text="00:00" name="stats-taggedtime" class="loadout-stat-value"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="challenges-container" class="loadout-edge-container loadout-challenges-container card hidden">
            <ui:VisualElement class="loadout-challenges-wip-wrap">
                <ui:Label text="WIP" class="loadout-challenges-wip"/>
            </ui:VisualElement>
            <ui:VisualElement name="stats-challenges-list" class="hidden"/>
            <ui:VisualElement name="stats-weekly-challenges-list" class="hidden"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="material-packet-panel" class="panel full-abs hidden material-packet-panel">
        <ui:VisualElement name="material-packet-container" class="material-packet-container card">
            <ui:VisualElement name="material-packet-header" class="material-packet-header">
                <ui:Button text="BACK" name="material-packet-back" class="menu-chip menu-chip-enabled back-button"/>
                <ui:Label text="SELECT MATERIAL PACKET" name="material-packet-title" class="title"/>
            </ui:VisualElement>
            <ui:ScrollView name="material-packet-scroll" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" class="material-packet-scroll">
                <ui:VisualElement name="material-packet-grid" class="material-packet-grid"/>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="player-model-viewport" class="player-model-viewport"/>
    <ui:Instance template="SharedOptionsPanel" class="full-abs" picking-mode="Ignore"/>
    <ui:VisualElement name="credits-panel" class="panel full-abs center-xy hidden">
        <ui:VisualElement name="credits-container" class="credits-container card">
            <ui:Label text="CREDITS" name="credits-label" class="title"/>
            <ui:VisualElement name="credits-content" class="credits-content">
                <ui:VisualElement name="main-logo-container" class="main-logo-container">
                    <ui:Image name="main-credits-logo" class="main-credits-logo"/>
                </ui:VisualElement>
                <ui:Label text="Made in Unity by whosteenie" name="credits-text" class="credits-text"/>
                <ui:Label text="Playtested by LMC" name="credits-text" class="credits-text"/>
                <ui:Label text="gt_homage &amp; gt_thelab - 262" name="credits-text" class="credits-text"/>
                <ui:Label text="v0.0.0" name="version-text" class="credits-text"/>
                <ui:VisualElement name="logo-container" class="logo-container">
                    <ui:Image name="credits-logo" class="credits-logo"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="credits-buttons" class="button-row">
                <ui:Button text="BACK" name="back-to-lobby" class="menu-chip menu-chip-enabled back-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="toast-container" enabled="false" class="toast-container">
        <ui:Label text="" name="toast" class="toast hide"/>
    </ui:VisualElement>
    <ui:VisualElement name="unsaved-changes-modal" class="unsaved-changes-modal full-abs hidden">
        <ui:VisualElement name="unsaved-changes-container" class="unsaved-changes-container card">
            <ui:Label text="UNSAVED CHANGES" name="unsaved-changes-title" class="title"/>
            <ui:Label text="Do you want to apply unsaved changes?" name="unsaved-changes-message" class="unsaved-changes-message"/>
            <ui:VisualElement name="unsaved-changes-buttons" class="unsaved-changes-buttons">
                <ui:Button text="YES" name="unsaved-changes-yes" class="menu-chip menu-chip-enabled"/>
                <ui:Button text="NO" name="unsaved-changes-no" class="menu-chip menu-chip-enabled back-button"/>
                <ui:Button text="CANCEL" name="unsaved-changes-cancel" class="menu-chip menu-chip-enabled"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="loadout-unsaved-changes-modal" class="unsaved-changes-modal full-abs hidden">
        <ui:VisualElement name="loadout-unsaved-changes-container" class="unsaved-changes-container card">
            <ui:Label text="UNSAVED CHANGES" name="loadout-unsaved-changes-title" class="title"/>
            <ui:Label text="Do you want to apply your loadout changes?" name="loadout-unsaved-changes-message" class="unsaved-changes-message"/>
            <ui:VisualElement name="loadout-unsaved-changes-buttons" class="unsaved-changes-buttons">
                <ui:Button text="APPLY" name="loadout-unsaved-yes" class="menu-chip menu-chip-enabled"/>
                <ui:Button text="DISCARD" name="loadout-unsaved-no" class="menu-chip menu-chip-enabled back-button"/>
                <ui:Button text="CANCEL" name="loadout-unsaved-cancel" class="menu-chip menu-chip-enabled"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="quit-confirmation-modal" class="unsaved-changes-modal full-abs hidden">
        <ui:VisualElement name="quit-confirmation-container" class="unsaved-changes-container card">
            <ui:Label text="QUIT GAME" name="quit-confirmation-title" class="title"/>
            <ui:Label text="Are you sure you want to quit?" name="quit-confirmation-message" class="unsaved-changes-message"/>
            <ui:VisualElement name="quit-confirmation-buttons" class="unsaved-changes-buttons">
                <ui:Button text="YES" name="quit-confirmation-yes" class="menu-chip menu-chip-enabled"/>
                <ui:Button text="NO" name="quit-confirmation-no" class="menu-chip menu-chip-enabled"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="lobby-leave-modal" class="unsaved-changes-modal full-abs hidden">
        <ui:VisualElement name="lobby-leave-container" class="unsaved-changes-container card">
            <ui:Label text="LEAVE SESSION" name="lobby-leave-title" class="title"/>
            <ui:Label text="Are you sure you want to leave the session?" name="lobby-leave-message" class="unsaved-changes-message"/>
            <ui:VisualElement name="lobby-leave-buttons" class="unsaved-changes-buttons">
                <ui:Button text="YES" name="lobby-leave-yes" class="menu-chip menu-chip-enabled back-button"/>
                <ui:Button text="NO" name="lobby-leave-no" class="menu-chip menu-chip-enabled"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="party-container" picking-mode="Ignore" class="party-container">
        <ui:VisualElement name="party-members-list" picking-mode="Ignore" class="party-members-row"/>
        <ui:Button name="invite-friends-button" text="" class="invite-button menu-chip">
            <ui:Image name="invite-icon" class="plus-icon"/>
        </ui:Button>
        <ui:VisualElement name="party-separator" class="party-separator"/>
        <ui:VisualElement name="local-player-profile" picking-mode="Ignore" class="local-player-profile"/>
    </ui:VisualElement>
    <ui:VisualElement name="status-container" picking-mode="Ignore" class="status-container hidden">
        <ui:VisualElement name="status-info" picking-mode="Ignore" class="status-info-grouping">
            <ui:VisualElement name="queue-details" picking-mode="Ignore" class="queue-details-row">
                <ui:Label text="Deathmatch" name="queue-gamemode-label" picking-mode="Ignore" class="queue-info-label queue-gamemode"/>
                <ui:Label text="|" picking-mode="Ignore" class="queue-info-separator"/>
                <ui:Label text="00:00" name="queue-timer-label" picking-mode="Ignore" class="queue-info-label queue-timer"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button text="Cancel" name="cancel-matchmaking-button" picking-mode="Position" class="menu-chip cancel-button"/>
    </ui:VisualElement>
    <ui:VisualElement name="loading-overlay" picking-mode="Ignore" class="loading-overlay hidden"/>
    <ui:VisualElement name="context-menu-backdrop" picking-mode="Position" class="full-abs hidden"/>
    <ui:VisualElement name="party-context-menu" picking-mode="Position" class="context-menu hidden">
        <ui:Button text="View Profile" name="ctx-profile" class="context-menu-item"/>
        <ui:Button text="Steam Profile" name="ctx-steam-profile" class="context-menu-item"/>
        <ui:VisualElement name="ctx-separator-mute" class="context-menu-separator"/>
        <ui:Button text="Mute Text Chat" name="ctx-mute-chat" class="context-menu-item"/>
        <ui:Button text="Mute Voice" name="ctx-mute-voice" class="context-menu-item"/>
        <ui:Button text="Block Player" name="ctx-block" class="context-menu-item"/>
        <ui:VisualElement name="ctx-separator-management" class="context-menu-separator"/>
        <ui:Button text="Switch Team" name="ctx-switch-team" class="context-menu-item"/>
        <ui:Button text="Make Host" name="ctx-make-host" class="context-menu-item"/>
        <ui:Button text="Kick Member" name="ctx-kick" class="context-menu-item"/>
        <ui:Button text="Leave Party" name="ctx-leave" class="context-menu-item"/>
    </ui:VisualElement>
</ui:UXML>
