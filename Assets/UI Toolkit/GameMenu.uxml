<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/SharedStyles.uss?fileID=7433441132597879392&amp;guid=94b07ae9f6dfe3447bec848c3f2b4d36&amp;type=3#SharedStyles" />
    <Style src="project://database/Assets/UI%20Toolkit/GameMenu.uss?fileID=7433441132597879392&amp;guid=ba28be69539cc9b4fbc1ee3bcbb05d45&amp;type=3#GameMenu" />
    <Style src="project://database/Assets/UI%20Toolkit/SceneTransition.uss?fileID=7433441132597879392&amp;guid=4daa9d2117fa153469ed19a28f36d7c7&amp;type=3#SceneTransition" />
    
    <ui:Template name="SharedOptionsPanel" src="project://database/Assets/UI%20Toolkit/Components/OptionsPanel.uxml"/>
    <ui:VisualElement name="root-container" class="full-abs root-container-visibility">
        <ui:VisualElement name="damage-vignette-root" class="damage-vignette-container">
            <ui:VisualElement name="hit-front" class="damage-vignette side" />
            <ui:VisualElement name="hit-back" class="damage-vignette side" />
            <ui:VisualElement name="hit-left" class="damage-vignette side" />
            <ui:VisualElement name="hit-right" class="damage-vignette side" />
            <ui:VisualElement name="hit-frontLeft" class="corner">
                <ui:VisualElement class="corner-c corner-c-inline" />
                <ui:VisualElement class="corner-h corner-h-inline" />
                <ui:VisualElement class="corner-v corner-v-inline" />
            </ui:VisualElement>
            <ui:VisualElement name="hit-frontRight" class="corner">
                <ui:VisualElement class="corner-c corner-c-position-absolute-right-0" />
                <ui:VisualElement class="corner-h corner-h-inline-right-35px" />
                <ui:VisualElement class="corner-v corner-v-inline-top-35px-bottom-auto" />
            </ui:VisualElement>
            <ui:VisualElement name="hit-backLeft" class="corner">
                <ui:VisualElement class="corner-c corner-c-position-absolute-bottom-0-left-0" />
                <ui:VisualElement class="corner-h corner-h-inline-left-35px" />
                <ui:VisualElement class="corner-v corner-v-inline-bottom-35px-top-auto" />
            </ui:VisualElement>
            <ui:VisualElement name="hit-backRight" class="corner">
                <ui:VisualElement class="corner-c corner-c-position-absolute-bottom-0-right-0" />
                <ui:VisualElement class="corner-h corner-h-inline-left-auto-right-35px" />
                <ui:VisualElement class="corner-v corner-v-inline-bottom-35px-top-auto-right" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="sniper-overlay" class="sniper-overlay hidden">
            <ui:VisualElement name="sniper-crosshair" class="sniper-crosshair">
                <ui:VisualElement name="sniper-crosshair-horizontal" class="sniper-crosshair-bar horizontal" />
                <ui:VisualElement name="sniper-crosshair-vertical" class="sniper-crosshair-bar vertical" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="hud-panel" class="hud hud-visibility-visible">
            <ui:VisualElement name="match-timer-score-container" class="match-timer-score-container">
                <ui:VisualElement name="left-score-container" class="hud-score-container hud-score-your">
                    <ui:Label name="left-score-value" text="0" class="hud-score-value" />
                </ui:VisualElement>
                <ui:VisualElement name="match-timer-container" class="match-timer-container match-timer-container-max-width">
                    <ui:Label name="match-timer-label" text="00:00" class="match-timer-label" />
                </ui:VisualElement>
                <ui:VisualElement name="right-score-container" class="hud-score-container hud-score-enemy">
                    <ui:Label name="right-score-value" text="0" class="hud-score-value" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="out-of-bounds-countdown-label" text="RETURN TO BATTLEFIELD: 3.00" class="out-of-bounds-countdown-label" />
            <ui:VisualElement name="health-container" class="health-container">
                <ui:ProgressBar name="health-bar" low-value="0" high-value="100" value="100" class="health-bar" />
                <ui:Label name="health-value" text="100" class="health-value" />
            </ui:VisualElement>
            <ui:VisualElement name="grapple-indicator-bottom" class="grapple-indicator-bottom">
                <ui:VisualElement name="grapple-indicator-fill" class="grapple-indicator-fill" />
            </ui:VisualElement>
            <ui:VisualElement name="multiplier-container" class="multiplier-container">
                <ui:ProgressBar name="multiplier-bar" class="multiplier-bar" />
                <ui:Label name="multiplier-value" text="1.00x" class="multiplier-value" />
            </ui:VisualElement>
            <ui:VisualElement name="ammo-container" class="ammo-container">
                <ui:Label name="ammo-current" text="30" class="ammo-text ammo-current" />
                <ui:VisualElement name="ammo-separator" class="ammo-separator" />
                <ui:Label name="ammo-total" text="30" class="ammo-text ammo-total" />
            </ui:VisualElement>
            <ui:VisualElement name="crosshair-container" class="crosshair">
                <ui:VisualElement name="crosshair-horizontal" class="crosshair-line horizontal" />
                <ui:VisualElement name="crosshair-vertical" class="crosshair-line vertical" />
                <ui:VisualElement name="crosshair-dot" class="crosshair-dot hidden" />
                <ui:Label name="hopball-interact-prompt" text="PRESS INTERACT" class="hopball-interact-prompt" />
                <ui:VisualElement name="grapple-indicator" class="grapple-indicator" />
            </ui:VisualElement>
            <ui:VisualElement name="chat-container" class="chat-container">
                <!-- Background wrapper - shows/hides background and border -->
                <ui:VisualElement name="chat-background" class="chat-background minimized">
                    <ui:ScrollView name="chat-scroll" class="chat-scroll" vertical-scroller-visibility="Auto">
                        <ui:VisualElement name="chat-message-list" class="chat-message-list" />
                    </ui:ScrollView>
                </ui:VisualElement>
                <!-- Input Field - Shown when chat is open -->
                <ui:TextField name="chat-input" class="chat-input minimized" />
            </ui:VisualElement>
            <ui:VisualElement name="voice-overlay-container" class="voice-overlay-container" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="kill-feed-container" class="kill-feed-container" />
        <ui:VisualElement name="respawn-fade-overlay" class="transition-overlay hidden" />
        <ui:VisualElement name="pause-challenges-container" class="pause-challenges-container hidden">
            <ui:VisualElement name="pause-daily-card-slot" class="pause-challenges-slot pause-challenges-slot-daily" />
            <ui:VisualElement name="pause-challenges-spacer" class="pause-challenges-spacer" />
            <ui:VisualElement name="pause-weekly-card-slot" class="pause-challenges-slot pause-challenges-slot-weekly" />
        </ui:VisualElement>
        <ui:VisualElement name="pause-menu-panel" class="panel full-abs center-xy hidden">
            <ui:VisualElement name="pause-container" class="menu-container card">
                <ui:VisualElement name="pause-header" class="pause-header">
                    <ui:Label text="PAUSED" name="pause-label" class="title" />
                </ui:VisualElement>
                <ui:Button text="RESUME" name="resume-button" class="menu-chip menu-chip-enabled" />
                <ui:Button text="OPTIONS" name="options-button" class="menu-chip menu-chip-enabled" />
                <ui:Button text="QUIT TO MENU" name="quit-button" class="menu-chip menu-chip-enabled" />
            </ui:VisualElement>
            <ui:VisualElement name="pause-loadout-container" class="pause-loadout-container card">
                <ui:Label text="LOADOUT" name="pause-loadout-title" class="pause-loadout-title" />
                <ui:VisualElement name="pause-primary-weapon-container" class="pause-weapon-slot-container">
                    <ui:VisualElement name="pause-primary-weapon-row" class="pause-weapon-slot-row">
                        <ui:VisualElement name="pause-primary-weapon-slot" class="pause-weapon-slot">
                            <ui:Image name="pause-primary-weapon-image" class="pause-weapon-image" />
                            <ui:Label text="" name="pause-primary-weapon-name" class="pause-weapon-name" />
                        </ui:VisualElement>
                        <ui:VisualElement name="pause-primary-dropdown" class="pause-weapon-dropdown hidden">
                            <ui:ScrollView name="pause-primary-scroll" class="pause-weapon-dropdown-scroll" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="PRIMARY" class="pause-weapon-slot-label" />
                </ui:VisualElement>
                <ui:VisualElement name="pause-secondary-weapon-container" class="pause-weapon-slot-container">
                    <ui:VisualElement name="pause-secondary-weapon-row" class="pause-weapon-slot-row">
                        <ui:VisualElement name="pause-secondary-weapon-slot" class="pause-weapon-slot">
                            <ui:Image name="pause-secondary-weapon-image" class="pause-weapon-image" />
                            <ui:Label text="" name="pause-secondary-weapon-name" class="pause-weapon-name" />
                        </ui:VisualElement>
                        <ui:VisualElement name="pause-secondary-dropdown" class="pause-weapon-dropdown hidden">
                            <ui:ScrollView name="pause-secondary-scroll" class="pause-weapon-dropdown-scroll" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="SECONDARY" class="pause-weapon-slot-label" />
                </ui:VisualElement>
                <ui:VisualElement name="pause-tertiary-weapon-container" class="pause-weapon-slot-container">
                    <ui:VisualElement name="pause-tertiary-weapon-row" class="pause-weapon-slot-row">
                        <ui:VisualElement name="pause-tertiary-weapon-slot" class="pause-weapon-slot">
                            <ui:Image name="pause-tertiary-weapon-image" class="pause-weapon-image" />
                            <ui:Label text="" name="pause-tertiary-weapon-name" class="pause-weapon-name" />
                        </ui:VisualElement>
                        <ui:VisualElement name="pause-tertiary-dropdown" class="pause-weapon-dropdown hidden">
                            <ui:ScrollView name="pause-tertiary-scroll" class="pause-weapon-dropdown-scroll" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="" class="pause-weapon-slot-label" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Instance template="SharedOptionsPanel" class="full-abs" picking-mode="Ignore"/>
        <ui:VisualElement name="podium-nameplates-container" class="podium-nameplates podium-nameplates-inline podium-nameplates-height-100-top-auto">
            <ui:VisualElement name="podium-second-slot" class="podium-slot podium-slot-second podium-slot-second-inline podium-slot-second-left-556-top-825">
                <ui:Label name="podium-second-name" text="SECOND PLACE" class="podium-name" />
                <ui:VisualElement class="podium-kills-row">
                    <ui:Label name="podium-second-kills" text="0" class="podium-kills-text" />
                    <ui:VisualElement name="podium-second-skull" class="podium-kill-icon podium-kill-icon-inline" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="podium-first-slot" class="podium-slot podium-slot-first podium-slot-first-inline podium-slot-first-top-724-left-947">
                <ui:Label name="podium-first-name" text="FIRST PLACE" class="podium-name" />
                <ui:VisualElement class="podium-kills-row">
                    <ui:Label name="podium-first-kills" text="0" class="podium-kills-text" />
                    <ui:VisualElement name="podium-first-skull" class="podium-kill-icon podium-kill-icon-inline" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="podium-third-slot" class="podium-slot podium-slot-third podium-slot-third-inline podium-slot-third-top-712-left-1125">
                <ui:Label name="podium-third-name" text="THIRD PLACE" class="podium-name" />
                <ui:VisualElement class="podium-kills-row">
                    <ui:Label name="podium-third-kills" text="0" class="podium-kills-text" />
                    <ui:VisualElement name="podium-third-skull" class="podium-kill-icon podium-kill-icon-inline-alt" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="xp-postmatch-container" class="xp-postmatch-container hidden">
            <ui:Label name="level-label" class="xp-level-label" text="LEVEL 1" />
            <ui:ProgressBar name="xp-bar" class="xp-progress-bar" low-value="0" high-value="1000" value="0" />
            <ui:Label name="xp-gained-label" class="xp-gained-label" text="+0 XP" />
        </ui:VisualElement>
        <ui:VisualElement name="scoreboard-panel" class="panel full-abs center-xy hidden">
            <ui:VisualElement name="scoreboard-container" class="scoreboard-container card">
                <ui:VisualElement class="scoreboard-title-row">
                    <ui:Label text="SCOREBOARD" name="scoreboard-title" class="title scoreboard-mode-title" />
                    <ui:Label text="UNKNOWN MAP" name="scoreboard-map-title" class="title scoreboard-map-title" />
                </ui:VisualElement>
                <ui:VisualElement name="scoreboard-header" class="scoreboard-header scoreboard-header-height-38px">
                    <ui:Label text="PING" class="header-cell ping-cell" />
                    <ui:VisualElement class="header-cell avatar-cell" />
                    <ui:Label class="header-cell name-cell" />
                    <ui:Label text="K" class="header-cell stat-cell" />
                    <ui:Label text="D" class="header-cell stat-cell" />
                    <ui:Label text="A" class="header-cell stat-cell" />
                    <ui:Label text="KDR" class="header-cell stat-cell" />
                    <ui:Label text="DMG" class="header-cell stat-cell" />
                    <ui:Label text="HS%" class="header-cell stat-cell" />
                    <ui:Label text="AV" class="header-cell stat-cell" />
                </ui:VisualElement>
                <ui:ScrollView name="scoreboard-scroll" class="scoreboard-scroll">
                    <ui:VisualElement name="player-rows" class="player-rows" />
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="tdm-scoreboard-container" class="tdm-scoreboard-container card hidden">
                <ui:VisualElement class="scoreboard-title-row">
                    <ui:Label text="TEAM DEATHMATCH" name="tdm-scoreboard-title" class="title scoreboard-mode-title" />
                    <ui:Label text="UNKNOWN MAP" name="tdm-scoreboard-map-title" class="title scoreboard-map-title" />
                </ui:VisualElement>
                <ui:VisualElement name="enemy-team-section" class="tdm-team-section tdm-team-section-enemy">
                    <ui:VisualElement name="enemy-team-header" class="tdm-team-header">
                        <ui:Label text="PING" class="header-cell ping-cell" />
                        <ui:VisualElement class="header-cell avatar-cell" />
                        <ui:Label class="header-cell name-cell" />
                        <ui:Label text="K" class="header-cell stat-cell" />
                        <ui:Label text="D" class="header-cell stat-cell" />
                        <ui:Label text="A" class="header-cell stat-cell" />
                        <ui:Label text="KDR" class="header-cell stat-cell" />
                        <ui:Label text="DMG" class="header-cell stat-cell" />
                        <ui:Label text="HS%" class="header-cell stat-cell" />
                        <ui:Label text="AV" class="header-cell stat-cell" />
                    </ui:VisualElement>
                    <ui:ScrollView name="enemy-team-scroll" class="tdm-team-scroll">
                        <ui:VisualElement name="enemy-team-rows" class="player-rows" />
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement name="tdm-score-display" class="tdm-score-display tdm-score-display-styled">
                    <ui:VisualElement name="your-score-container" class="tdm-score-container tdm-score-your tdm-score-container-styled">
                        <ui:Label name="your-score-value" text="0" class="tdm-score-value tdm-score-value-styled" />
                    </ui:VisualElement>
                    <ui:Label text="VS" name="tdm-vs-label" class="tdm-vs-label tdm-vs-label-styled" />
                    <ui:VisualElement name="enemy-score-container" class="tdm-score-container tdm-score-enemy tdm-score-container-enemy-styled">
                        <ui:Label name="enemy-score-value" text="0" class="tdm-score-value tdm-score-value-styled" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="your-team-section" class="tdm-team-section tdm-team-section-your">
                    <ui:VisualElement name="your-team-header" class="tdm-team-header tdm-team-header-your">
                        <ui:Label text="PING" class="header-cell ping-cell" />
                        <ui:VisualElement class="header-cell avatar-cell" />
                        <ui:Label class="header-cell name-cell" />
                        <ui:Label text="K" class="header-cell stat-cell" />
                        <ui:Label text="D" class="header-cell stat-cell" />
                        <ui:Label text="A" class="header-cell stat-cell" />
                        <ui:Label text="KDR" class="header-cell stat-cell" />
                        <ui:Label text="DMG" class="header-cell stat-cell" />
                        <ui:Label text="HS%" class="header-cell stat-cell" />
                        <ui:Label text="AV" class="header-cell stat-cell" />
                    </ui:VisualElement>
                    <ui:ScrollView name="your-team-scroll" class="tdm-team-scroll">
                        <ui:VisualElement name="your-team-rows" class="player-rows" />
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="unsaved-changes-modal" class="unsaved-changes-modal full-abs hidden">
        <ui:VisualElement name="unsaved-changes-container" class="unsaved-changes-container card">
            <ui:Label text="UNSAVED CHANGES" name="unsaved-changes-title" class="title" />
            <ui:Label text="Do you want to apply unsaved changes?" name="unsaved-changes-message" class="unsaved-changes-message" />
            <ui:VisualElement name="unsaved-changes-buttons" class="unsaved-changes-buttons">
                <ui:Button text="YES" name="unsaved-changes-yes" class="menu-chip menu-chip-enabled" />
                <ui:Button text="NO" name="unsaved-changes-no" class="menu-chip menu-chip-enabled back-button" />
                <ui:Button text="CANCEL" name="unsaved-changes-cancel" class="menu-chip menu-chip-enabled" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="quit-confirmation-modal" class="unsaved-changes-modal full-abs hidden">
        <ui:VisualElement name="quit-confirmation-container" class="unsaved-changes-container card">
            <ui:Label text="QUIT TO MENU" name="quit-confirmation-title" class="title" />
            <ui:Label text="Are you sure you want to leave the match?" name="quit-confirmation-message" class="unsaved-changes-message" />
            <ui:VisualElement name="quit-confirmation-buttons" class="unsaved-changes-buttons">
                <ui:Button text="YES" name="quit-confirmation-yes" class="menu-chip menu-chip-enabled" />
                <ui:Button text="NO" name="quit-confirmation-no" class="menu-chip menu-chip-enabled" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    
    <!-- In-Game Player Context Menu -->
    <ui:VisualElement name="context-menu-backdrop" class="full-abs hidden" picking-mode="Position" />
    <ui:VisualElement name="player-context-menu" class="context-menu hidden" picking-mode="Position">
        <ui:Button text="STEAM PROFILE" name="ctx-steam-profile" class="context-menu-item" />
        <ui:VisualElement class="context-menu-separator" />
        <ui:Button text="MUTE VOICE" name="ctx-mute-voice" class="context-menu-item" />
        <ui:Button text="BLOCK PLAYER" name="ctx-block" class="context-menu-item" />
    </ui:VisualElement>
</ui:UXML>
