@import url("styles/foundation/theme-tokens.uss");
@import url("styles/components/challenge-cards.uss");
@import url("styles/components/modals.uss");
@import url("styles/components/context-and-copy-controls.uss");
@import url("styles/components/settings-controls.uss");
@import url("styles/screens/options-panel.uss");
@import url("styles/foundation/unity-overrides.uss");

/* ===== GLOBAL RESET ===== */
* {
    color: var(--color-text-primary);
    -unity-font-style: normal;
}

/* ===== UTILITY CLASSES ===== */
.hidden {
    display: none;
}

.full-abs {
    position: absolute;
    width: 100%;
    height: 100%;
}

.center-xy {
    align-items: center;
    justify-content: center;
}

/* ===== LAYOUT COMPONENTS ===== */
.ui-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background-color: var(--color-bg-overlay);
}

.panel {
    background-color: transparent;
}

.card {
    background-color: var(--color-bg-card);
    border-radius: var(--radius-md);
    border-width: 1px;
    border-color: var(--color-accent-border-soft);
    /* Subtle inner glow effect via border */
}

/* ===== TYPOGRAPHY ===== */
.title {
    -unity-font-style: bold;
    color: var(--color-white);
    letter-spacing: 2px;
    margin-bottom: 10px;
    font-size: 32px;
    text-shadow: 0 0 8px var(--color-accent-border);
}

.title-xl {
    font-size: 100px;
    text-shadow: 0 0 12px var(--color-accent-bg-mid);
}

.section {
    margin-top: 14px;
    margin-bottom: 18px;
}

.section-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--color-text-secondary);
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-accent-border);
}

/* Remove border from playerlist title */
#playerlist-label {
    border-bottom-width: 0;
    border-bottom-color: transparent;
    padding-bottom: 0;
}

.accent {
    color: var(--color-accent);
}

/* ===== BUTTONS ===== */
.menu-chip {
    height: 48px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: var(--color-bg-surface);
    border-radius: var(--radius-md);
    border-width: 1px;
    border-color: var(--color-accent-border);
    -unity-font-style: bold;
    font-size: 14px;
    color: var(--color-text-primary);
    transition-duration: var(--dur-fast);
}

.menu-chip-enabled:hover {
    background-color: var(--color-accent-bg-soft);
    border-color: var(--color-accent-border-strong);
    color: var(--color-white);
}

.menu-chip:active {
    background-color: var(--color-accent-bg-mid);
    border-color: var(--color-accent-border-pressed);
}

.button-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 20px;
}

.button-row .menu-chip {
    margin-left: 10px;
    margin-right: 10px;
}

/* ===== SCROLLING ===== */
.scroll-pad {
    padding: 10px;
}

/* ===== MAIN MENU XP BAR ===== */
.mainmenu-xp-bar {
    height: 6px;
    min-height: 6px;
    max-height: 6px;
    margin: 0;
    padding: 0;
    background-color: transparent;
    border-width: 0;
}

.mainmenu-xp-bar .unity-progress-bar__container {
    height: 6px;
    min-height: 6px;
    max-height: 6px;
    margin: 0;
    padding: 0;
    background-color: transparent;
}

.mainmenu-xp-bar .unity-progress-bar__background {
    height: 6px;
    min-height: 6px;
    max-height: 6px;
    background-color: rgba(255, 255, 255, 0.2);
    border-width: 0;
    border-radius: var(--radius-sm);
    margin: 0;
    padding: 0;
}

.mainmenu-xp-bar .unity-progress-bar__progress {
    height: 6px;
    min-height: 6px;
    max-height: 6px;
    background-color: var(--color-accent);
    border-radius: var(--radius-sm);
    margin: 0;
    padding: 0;
}

.mainmenu-xp-bar .unity-progress-bar__title-container {
    display: none;
    height: 0;
}

/* Hide placeholder when input has value */
#join-input.has-value > .unity-base-text-field__input-placeholder {
    display: none;
}

/* Join code input styling */
#join-input {
    --unity-cursor-color: var(--cursor-color);
    background-color: var(--color-bg-input);
    border-width: 0;
    border-radius: var(--radius-md);
    padding: 8px 12px;
}

#join-input > .unity-base-text-field__input {
    --unity-cursor-color: var(--cursor-color);
    background-color: var(--color-bg-input);
    border-width: 0;
}

#join-input > .unity-text-element--inner-input-field-component {
    --unity-cursor-color: rgb(240, 240, 240);
}

/* ===== INLINE STYLE MIGRATIONS ===== */
