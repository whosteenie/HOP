@import url("styles/components/challenge-cards.uss");
@import url("styles/components/modals.uss");
@import url("styles/components/settings-controls.uss");
@import url("styles/screens/options-panel.uss");
@import url("styles/foundation/unity-overrides.uss");

/* ===== GLOBAL RESET ===== */
* {
    color: rgb(240, 240, 240);
    -unity-font-style: normal;
}

/* ===== UTILITY CLASSES ===== */
.hidden {
    display: none;
}

.full-abs {
    position: absolute;
    width: 100%;
    height: 100%;
}

.center-xy {
    align-items: center;
    justify-content: center;
}

/* ===== LAYOUT COMPONENTS ===== */
.ui-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background-color: rgba(5, 5, 8, 0.88);
}

.panel {
    background-color: transparent;
}

.card {
    background-color: rgba(12, 12, 18, 0.96);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.2);
    /* Subtle inner glow effect via border */
}

/* ===== TYPOGRAPHY ===== */
.title {
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    letter-spacing: 2px;
    margin-bottom: 10px;
    font-size: 32px;
    text-shadow: 0 0 8px rgba(200, 60, 60, 0.3);
}

.title-xl {
    font-size: 100px;
    text-shadow: 0 0 12px rgba(200, 60, 60, 0.4);
}

.section {
    margin-top: 14px;
    margin-bottom: 18px;
}

.section-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(220, 220, 220);
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(200, 60, 60, 0.3);
}

/* Remove border from playerlist title */
#playerlist-label {
    border-bottom-width: 0;
    border-bottom-color: transparent;
    padding-bottom: 0;
}

.accent {
    color: rgb(255, 100, 100);
}

/* ===== BUTTONS ===== */
.menu-chip {
    height: 48px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: rgba(20, 20, 25, 0.8);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.3);
    -unity-font-style: bold;
    font-size: 14px;
    color: rgb(240, 240, 240);
    transition-duration: 0.2s;
}

.menu-chip-enabled:hover {
    background-color: rgba(200, 60, 60, 0.2);
    border-color: rgba(255, 100, 100, 0.6);
    color: rgb(255, 255, 255);
}

.menu-chip:active {
    background-color: rgba(200, 60, 60, 0.4);
    border-color: rgba(255, 100, 100, 0.8);
}

.button-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 20px;
}

.button-row .menu-chip {
    margin-left: 10px;
    margin-right: 10px;
}

/* ===== SCROLLING ===== */
.scroll-pad {
    padding: 10px;
}

/* ===== MAIN MENU XP BAR ===== */
.mainmenu-xp-bar {
    height: 6px;
    min-height: 6px;
    max-height: 6px;
    margin: 0;
    padding: 0;
    background-color: transparent;
    border-width: 0;
}

.mainmenu-xp-bar .unity-progress-bar__container {
    height: 6px;
    min-height: 6px;
    max-height: 6px;
    margin: 0;
    padding: 0;
    background-color: transparent;
}

.mainmenu-xp-bar .unity-progress-bar__background {
    height: 6px;
    min-height: 6px;
    max-height: 6px;
    background-color: rgba(255, 255, 255, 0.2);
    border-width: 0;
    border-radius: 3px;
    margin: 0;
    padding: 0;
}

.mainmenu-xp-bar .unity-progress-bar__progress {
    height: 6px;
    min-height: 6px;
    max-height: 6px;
    background-color: rgb(255, 100, 100);
    border-radius: 3px;
    margin: 0;
    padding: 0;
}

.mainmenu-xp-bar .unity-progress-bar__title-container {
    display: none;
    height: 0;
}

/* Hide placeholder when input has value */
#join-input.has-value > .unity-base-text-field__input-placeholder {
    display: none;
}

/* Join code input styling */
#join-input {
    --unity-cursor-color: rgb(240, 240, 240);
    background-color: rgba(10, 10, 15, 0.9);
    border-width: 0;
    border-radius: 4px;
    padding: 8px 12px;
}

#join-input > .unity-base-text-field__input {
    --unity-cursor-color: rgb(240, 240, 240);
    background-color: rgba(10, 10, 15, 0.9);
    border-width: 0;
}

#join-input > .unity-text-element--inner-input-field-component {
    --unity-cursor-color: rgb(240, 240, 240);
}

/* Player name input cursor color (loadout screen) */
.player-name-input {
    --unity-cursor-color: rgb(240, 240, 240);
}

.player-name-input > .unity-base-text-field__input {
    --unity-cursor-color: rgb(240, 240, 240);
}

.player-name-input > .unity-text-element--inner-input-field-component {
    --unity-cursor-color: rgb(240, 240, 240);
}

/* First time modal name input cursor color */
.first-time-name-input {
    --unity-cursor-color: rgb(240, 240, 240);
}

.first-time-name-input > .unity-base-text-field__input {
    --unity-cursor-color: rgb(240, 240, 240);
}

.first-time-name-input > .unity-text-element--inner-input-field-component {
    --unity-cursor-color: rgb(240, 240, 240);
}

/* ===== INLINE STYLE MIGRATIONS ===== */
