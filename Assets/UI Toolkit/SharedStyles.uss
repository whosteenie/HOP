}

.justify-content-flex-start {
    justify-content: flex-start;
}

.position-absolute {
    position: absolute;
}

.position-relative {
    position: relative;
}

.width-36px {
    width: 36px;
}

.width-24px {
    width: 24px;
    height: 24px;
}

.height-auto {
    height: auto;
}

.min-width-40px {
    min-width: 40px;
}

.min-width-200px {
    min-width: 200px;
}

.max-width-200px {
    max-width: 200px;
}

.max-width-112px {
    max-width: 112px;
}

.min-height-88px {
    min-height: 88px;
}

.min-height-350px {
    min-height: 350px;
}

.height-68px {
    height: 68px;
}

.height-154px {
    height: 154px;
}

.height-38px {
    height: 38px;
}

.margin-right-25px {
    margin-right: 25px;
}

.margin-right-5px {
    margin-right: 5px;
}

.margin-right-10px {
